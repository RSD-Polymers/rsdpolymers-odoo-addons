<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rsd_qa_management.QaDashboard" owl="1">
        <div class="o_qa_dashboard">
            <div class="o_qa_dashboard_header">
                <div>
                    <div class="o_qa_eyebrow">QUALITY MANAGEMENT</div>
                    <h1>Quality Assurance Dashboard</h1>
                    <p>Change Control overview and current workflow status.</p>
                </div>
                <div class="o_qa_header_tag"><i class="fa fa-shield"/> Quality • Overview</div>
            </div>
            <t t-if="state.loading"><div class="alert alert-info">Loading dashboard...</div></t>
            <t t-elif="state.error"><div class="alert alert-warning">Dashboard data could not be loaded. Please check your access rights.</div></t>
            <t t-else="">
                <div class="o_qa_metric_grid">
                    <button class="o_qa_metric_card" t-on-click="() => this.openRequests()">
                        <div class="o_qa_metric_top"><span>Total Requested</span><span class="o_qa_metric_icon text-primary"><i class="fa fa-files-o"/></span></div>
                        <div class="o_qa_metric_value" t-esc="state.data.total"/><div class="o_qa_metric_hint">All accessible Change Requests</div>
                    </button>
                    <button class="o_qa_metric_card" t-on-click="openCompleted">
                        <div class="o_qa_metric_top"><span>Completed</span><span class="o_qa_metric_icon text-success"><i class="fa fa-check-circle"/></span></div>
                        <div class="o_qa_metric_value" t-esc="state.data.completed"/><div class="o_qa_metric_hint">Successfully closed requests</div>
                    </button>
                    <button class="o_qa_metric_card" t-on-click="openPending">
                        <div class="o_qa_metric_top"><span>Pending</span><span class="o_qa_metric_icon text-warning"><i class="fa fa-clock-o"/></span></div>
                        <div class="o_qa_metric_value" t-esc="state.data.pending"/><div class="o_qa_metric_hint">Click to view pending requests</div>
                    </button>
                    <div class="o_qa_metric_card">
                        <div class="o_qa_metric_top"><span>Completion Rate</span><span class="o_qa_metric_icon text-info"><i class="fa fa-line-chart"/></span></div>
                        <div class="o_qa_metric_value"><t t-esc="state.data.completion_rate"/>%</div><div class="o_qa_metric_hint">Completed / total requested</div>
                    </div>
                </div>
                <div class="o_qa_section_heading"><div><h2>Change Request Stages</h2><p>Live count of requests in each workflow stage</p></div></div>
                <div class="o_qa_workspace_grid">
                    <t t-foreach="state.data.stages" t-as="stage" t-key="stage.key">
                        <button class="o_qa_workspace_card" t-on-click="() => this.openRequests([[&quot;state&quot;, &quot;=&quot;, stage.key]])">
                            <div class="o_qa_workspace_icon"><i class="fa fa-tasks"/></div>
                            <div><h3 t-esc="stage.label"/><p><strong t-esc="stage.count"/> Change Requests</p></div>
                            <span class="o_qa_arrow"><i class="fa fa-arrow-right"/></span>
                        </button>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>

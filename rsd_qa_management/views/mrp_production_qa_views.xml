<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mrp_production_form_qa_inspection" model="ir.ui.view">
        <field name="name">mrp.production.form.qa.inspection</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qa_inspections" type="object" class="oe_stat_button" icon="fa-shield" groups="rsd_qa_management.group_qa_officer,base.group_system">
                    <field name="qa_inspection_count" widget="statinfo" string="QA Inspection"/>
                </button>
            </xpath>
            <xpath expr="//sheet//group" position="inside">
                <field name="qa_inspection_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}" readonly="1" string="QA Tags"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Internal users have limited self-service access to their own requests and assigned tasks. -->
    <menuitem id="menu_qa_root" name="Quality Assurance" sequence="35"
              web_icon="rsd_qa_management,static/description/icon.png"
              groups="base.group_user"/>

    <record id="action_qa_dashboard" model="ir.actions.client">
        <field name="name">QA Dashboard</field>
        <field name="tag">rsd_qa_management.dashboard</field>
    </record>
    <menuitem id="menu_qa_dashboard" name="Dashboard" parent="menu_qa_root"
              action="action_qa_dashboard" sequence="1"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>


    <!-- Unified Inspection menu: MO inspections and both deviation types. -->
    <menuitem id="menu_qa_inspection" name="Inspection" parent="menu_qa_root" sequence="15"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_mo_inspection" name="MO Inspection" parent="menu_qa_inspection"
              action="action_qa_mo_inspection" sequence="10"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_planned_deviation" name="Planned Deviation" parent="menu_qa_inspection"
              action="action_qa_planned_deviation" sequence="20"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_post_process_deviation" name="Post-Process Deviation" parent="menu_qa_inspection"
              action="action_qa_post_process_deviation" sequence="30"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_all_deviations" name="All Deviations" parent="menu_qa_inspection"
              action="action_qa_all_deviations" sequence="40"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>

    <menuitem id="menu_qa_change_management" name="Change Management"
              parent="menu_qa_root" sequence="10"/>
    <!-- Full workflow is visible only to QA. -->
    <menuitem id="menu_qa_change_control" name="Change Control"
              parent="menu_qa_change_management" action="action_qa_change_control"
              sequence="10" groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <!-- Requesters and task assignees retain access to only their own work. -->
    <menuitem id="menu_qa_my_change_requests" name="My Change Requests"
              parent="menu_qa_change_management" action="action_qa_my_change_requests"
              sequence="20" groups="base.group_user"/>
    <menuitem id="menu_qa_my_evaluation_tasks" name="My Evaluation Tasks"
              parent="menu_qa_change_management" action="action_qa_my_evaluation_tasks"
              sequence="30" groups="base.group_user"/>
    <!-- QA Managers share the pending approval queue. -->
    <menuitem id="menu_qa_my_approvals" name="Pending Approvals"
              parent="menu_qa_change_management" action="action_qa_my_approvals"
              sequence="40" groups="rsd_qa_management.group_qa_manager"/>

    <menuitem id="menu_qa_document_change_request" name="Document Change Request"
              parent="menu_qa_change_management" sequence="50"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>

    <!-- Other QA modules are not yet employee self-service workflows. -->
    <menuitem id="menu_qa_complaints_non_compliance" name="Complaints / NC"
              parent="menu_qa_root" sequence="20"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_customer_complaints" name="Customer Complaints"
              parent="menu_qa_complaints_non_compliance" sequence="10"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_product_non_conformity" name="Product Non-Conformity (OOS)"
              parent="menu_qa_complaints_non_compliance" sequence="20"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_process_non_conformity" name="Process Non-Conformity (For all Dept.)"
              parent="menu_qa_complaints_non_compliance" sequence="30"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>

    <menuitem id="menu_qa_audits" name="Audits" parent="menu_qa_root"
              sequence="30" groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_internal_audits" name="Internal Audits"
              parent="menu_qa_audits" sequence="10"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_mrm_mom" name="MRM and MOM"
              parent="menu_qa_audits" sequence="20"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_trend_analysis" name="Trend Analysis"
              parent="menu_qa_audits" sequence="30"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>

    <menuitem id="menu_qa_document_control" name="Document Control (Revalidation)"
              parent="menu_qa_root" sequence="40"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_sop" name="SOP" parent="menu_qa_document_control"
              sequence="10" groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_forms_formats" name="Forms and Formats"
              parent="menu_qa_document_control" sequence="20"
              groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_qsm" name="QSM" parent="menu_qa_document_control"
              sequence="30" groups="rsd_qa_management.group_qa_officer,base.group_system"/>
    <menuitem id="menu_qa_kpa_kra" name="KPA/KRA" parent="menu_qa_root"
              sequence="50" groups="rsd_qa_management.group_qa_officer,base.group_system"/>
</odoo>

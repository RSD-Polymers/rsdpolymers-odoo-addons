<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_qa_change_control_list" model="ir.ui.view">
        <field name="name">qa.change.control.list</field>
        <field name="model">qa.change.control</field>
        <field name="arch" type="xml">
            <list string="Change Control" decoration-success="state == 'completed'" decoration-danger="state == 'rejected'" decoration-warning="state in ('open', 'data_review', 'approval_pending')">
                <field name="name"/>
                <field name="description"/>
                <field name="requested_by_id"/>
                <field name="department_id"/>
                <field name="cr_type"/>
                <field name="request_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_qa_change_control_kanban" model="ir.ui.view">
        <field name="name">qa.change.control.kanban</field>
        <field name="model">qa.change.control</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" quick_create="false" group_create="false" group_edit="false" group_delete="false">
                <field name="name"/><field name="description"/><field name="requested_by_id"/>
                <field name="department_id"/><field name="cr_type"/><field name="state"/>
                <field name="request_date"/><field name="task_count"/><field name="pending_task_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="text-muted mb-2"><field name="description"/></div>
                            <div><i class="fa fa-user me-1"/><field name="requested_by_id"/></div>
                            <div><i class="fa fa-building me-1"/><field name="department_id"/></div>
                            <div class="mt-2 d-flex justify-content-between">
                                <span><field name="cr_type"/></span>
                                <span><field name="pending_task_count"/> pending tasks</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Keep Kanban stage dragging disabled for administrators as well. -->
    <record id="view_qa_change_control_kanban_admin" model="ir.ui.view">
        <field name="name">qa.change.control.kanban.admin.non.draggable</field>
        <field name="model">qa.change.control</field>
        <field name="inherit_id" ref="view_qa_change_control_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="/kanban" position="attributes">
                <attribute name="records_draggable">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_qa_change_control_search" model="ir.ui.view">
        <field name="name">qa.change.control.search</field>
        <field name="model">qa.change.control</field>
        <field name="arch" type="xml">
            <search string="Search Change Requests">
                <field name="name"/><field name="description"/><field name="requested_by_id"/>
                <field name="department_id"/><field name="cr_type"/>
                <filter name="my_requests" string="My Requests" domain="[('requested_by_id.user_id', '=', uid)]"/>
                <filter name="pending" string="Pending" domain="[('state', 'not in', ['completed', 'rejected'])]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="overdue" string="Overdue Tasks" domain="[('task_ids.expected_date', '&lt;', context_today()), ('task_ids.state', '!=', 'submitted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Stage" context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_type" string="CR Type" context="{'group_by': 'cr_type'}"/>
                    <filter name="group_requester" string="Requester" context="{'group_by': 'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_qa_change_control_form" model="ir.ui.view">
        <field name="name">qa.change.control.form</field>
        <field name="model">qa.change.control</field>
        <field name="arch" type="xml">
            <form string="Change Control">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_register" type="object" string="Register" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'open'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'open'"/>
                    <button name="action_start_evaluation" type="object" string="Start Evaluation" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'registered'"/>
                    <button name="action_send_for_approval" type="object" string="Send for Approval" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'data_review'"/>
                    <button name="action_ab_approve" type="object" string="Approve" class="btn-primary" groups="rsd_qa_management.group_qa_manager" invisible="state != 'approval_pending'"/>
                    <button name="action_ab_refuse" type="object" string="Refuse" class="btn-secondary" groups="rsd_qa_management.group_qa_manager" invisible="state != 'approval_pending'"/>
                    <button name="action_mark_done" type="object" string="Mark as Done" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'closing_report'"/>
                    <button name="action_view_tasks" type="object" string="Evaluation Tasks" class="btn-secondary" invisible="state not in ('evaluation', 'data_review', 'approval_pending', 'closing_report', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,registered,evaluation,data_review,approval_pending,closing_report,completed" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Evaluation Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Request Details">
                            <field name="requested_by_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="cr_type" readonly="state != 'draft'"/>
                            <field name="request_date"/>
                        </group>
                        <group string="QA Review">
                            <div class="text-muted">Managed by the QA Officer group. Final approval is handled by the QA Manager group.</div>
                        </group>
                    </group>
                    <group string="Request Description">
                        <field name="description" string="Details" placeholder="Provide the background and details of the request..." readonly="state != 'draft'"/>
                        <field name="proposed_change" placeholder="Describe what is proposed to be changed..." readonly="state != 'draft'"/>
                        <field name="reason" placeholder="Explain why this change is required..." readonly="state != 'draft'"/>
                        <field name="justification" placeholder="Provide supporting justification for the proposed change..." readonly="state != 'draft'"/>
                    </group>
                    <group string="Rejection" invisible="state != 'rejected'"><field name="rejection_reason" readonly="1"/></group>
                    <notebook>
                        <page string="Evaluation Tasks" invisible="state in ('draft', 'open', 'registered', 'rejected')">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div><strong>Task progress:</strong> <field name="submitted_task_count" nolabel="1"/> / <field name="task_count" nolabel="1"/> submitted</div>

                            </div>
                            <field name="task_ids"
                                   groups="rsd_qa_management.group_qa_officer"
                                   readonly="state != 'evaluation'">
                                <list create="1" delete="0">
                                    <field name="name" string="Task Title"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="assigned_employee_id"/>
                                    <field name="expected_date"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                    <field name="submitted_on" optional="hide"/>
                                </list>
                                <form string="Evaluation Task">
                                    <group>
                                        <group>
                                            <field name="name" string="Task Title"/>
                                            <field name="assigned_employee_id"
                                                   domain="[('active', '=', True)]"
                                                   options="{'no_create': True}"/>
                                            <field name="department_id" readonly="1"/>
                                            <field name="expected_date"/>
                                        </group>
                                        <group>
                                            <field name="state" widget="badge" readonly="1"/>
                                            <field name="submitted_on" readonly="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="description"
                                               placeholder="Describe the evaluation work, checks and expected outcome..."/>
                                        <field name="completion_comments"
                                               placeholder="Completion comments (if applicable)..."/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Data Review" invisible="state not in ('data_review', 'approval_pending', 'closing_report', 'completed')">
                            <group><field name="review_comments" readonly="state != 'data_review'"/></group>
                            <field name="document_ids" groups="rsd_qa_management.group_qa_officer" readonly="state != 'data_review'">
                                <list editable="bottom"><field name="name"/><field name="document_type"/><field name="attachment_ids" widget="many2many_binary"/><field name="uploaded_by_id"/></list>
                            </field>
                            <group><field name="approval_comment" readonly="1"/></group>
                        </page>
                        <page string="Approval History" invisible="not approval_ids">
                            <field name="approval_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="approver_id" string="Decision By"/><field name="requested_by_id"/><field name="requested_on"/>
                                    <field name="decision" widget="badge"/><field name="decision_date"/><field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Closing Report" invisible="state not in ('closing_report', 'completed')">
                            <group>
                                <field name="implementation_date" readonly="state == 'completed'"/>
                                <field name="completed_by_id" readonly="1"/>
                                <field name="completion_date" readonly="1"/>
                            </group>
                            <group><field name="implementation_details" readonly="state == 'completed'"/><field name="closing_report_attachment_ids" widget="many2many_binary" readonly="state == 'completed'"/><field name="final_comments" readonly="state == 'completed'"/></group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qa_change_control" model="ir.actions.act_window">
        <field name="name">Change Control</field>
        <field name="res_model">qa.change.control</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_qa_change_control_search"/>
        <field name="context">{'search_default_pending': 0}</field>
    </record>

    <!-- Limited self-service entry points for non-QA participants. -->
    <record id="action_qa_my_change_requests" model="ir.actions.act_window">
        <field name="name">My Change Requests</field>
        <field name="res_model">qa.change.control</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requested_by_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_qa_my_evaluation_tasks" model="ir.actions.act_window">
        <field name="name">My Evaluation Tasks</field>
        <field name="res_model">qa.change.control.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('assigned_user_id', '=', uid)]</field>
    </record>

    <record id="action_qa_my_approvals" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">qa.change.control</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'approval_pending')]</field>
    </record>

    <record id="view_qa_change_control_task_list" model="ir.ui.view">
        <field name="name">qa.change.control.task.list</field><field name="model">qa.change.control.task</field>
        <field name="arch" type="xml"><list string="Evaluation Tasks" decoration-success="state == 'submitted'" decoration-warning="state == 'rework'"><field name="name"/><field name="change_control_id"/><field name="department_id"/><field name="assigned_employee_id"/><field name="expected_date"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_qa_change_control_task_form" model="ir.ui.view">
        <field name="name">qa.change.control.task.form</field><field name="model">qa.change.control.task</field>
        <field name="arch" type="xml">
            <form string="Evaluation Task">
                <header>
                    <button name="action_start" type="object" string="Start Task" class="btn-primary" invisible="state not in ('assigned', 'rework') or assigned_user_id != uid"/>
                    <button name="action_submit" type="object" string="Submit Task" class="btn-primary" invisible="state not in ('assigned', 'in_progress', 'rework') or assigned_user_id != uid"/>
                    <button name="action_request_rework" type="object" string="Request Rework" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,in_progress,submitted,rework" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" groups="rsd_qa_management.group_qa_officer" readonly="state == 'submitted' or change_control_id.state != 'evaluation'"/>
                            <field name="name" groups="!rsd_qa_management.group_qa_officer" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="change_control_id" readonly="1"/>
                            <field name="department_id" groups="rsd_qa_management.group_qa_officer" readonly="1"/>
                            <field name="department_id" groups="!rsd_qa_management.group_qa_officer" readonly="1"/>
                            <field name="assigned_employee_id" groups="rsd_qa_management.group_qa_officer" readonly="state == 'submitted' or change_control_id.state != 'evaluation'"/>
                            <field name="assigned_employee_id" groups="!rsd_qa_management.group_qa_officer" readonly="1"/>
                            <field name="expected_date" groups="rsd_qa_management.group_qa_officer" readonly="state == 'submitted' or change_control_id.state != 'evaluation'"/>
                            <field name="expected_date" groups="!rsd_qa_management.group_qa_officer" readonly="1"/>
                        </group>
                        <group><field name="assigned_user_id" readonly="1"/><field name="submitted_on" readonly="1"/></group>
                    </group>
                    <group>
                        <field name="description" groups="rsd_qa_management.group_qa_officer" readonly="state == 'submitted' or change_control_id.state != 'evaluation'"/>
                        <field name="description" groups="!rsd_qa_management.group_qa_officer" readonly="1"/>
                        <field name="rework_instructions" readonly="1" invisible="not rework_instructions"/>
                        <field name="completion_comments"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_qa_change_control_task" model="ir.actions.act_window"><field name="name">Evaluation Tasks</field><field name="res_model">qa.change.control.task</field><field name="view_mode">list,form</field></record>

    <record id="view_qa_change_reject_wizard_form" model="ir.ui.view"><field name="name">qa.change.control.reject.wizard.form</field><field name="model">qa.change.control.reject.wizard</field><field name="arch" type="xml"><form string="Reject Change Request"><group><field name="change_control_id"/><field name="reason" placeholder="Enter rejection reason..."/></group><footer><button name="action_confirm" type="object" string="Confirm Rejection" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field></record>
    <record id="view_qa_change_approval_wizard_form" model="ir.ui.view"><field name="name">qa.change.control.approval.wizard.form</field><field name="model">qa.change.control.approval.wizard</field><field name="arch" type="xml"><form string="Refuse Change Request"><group><field name="change_control_id"/><field name="reason" placeholder="Enter refusal reason and required changes..."/></group><footer><button name="action_confirm" type="object" string="Confirm Refusal" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field></record>
    <record id="view_qa_change_task_rework_wizard_form" model="ir.ui.view">
        <field name="name">qa.change.control.task.rework.wizard.form</field>
        <field name="model">qa.change.control.task.rework.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Task Rework">
                <group>
                    <field name="task_id"/>
                    <field name="instructions" placeholder="Clearly describe what needs to be corrected, added or resubmitted..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Send Rework Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

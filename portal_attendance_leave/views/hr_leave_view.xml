<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_view_form_inherit_concession" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.concession</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!-- hide entire HALF DAY row -->
            <xpath expr="//field[@name='request_unit_half']" position="attributes">
                <attribute name="readonly">is_concession_leave</attribute>
            </xpath>

            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="context">
                    {
                    'default_employee_id': employee_id,
                    'employee_id': employee_id,
                    'od_worked_on': od_worked_on
                    }
                </attribute>
            </xpath>

            <xpath expr="//field[@name='request_date_from']" position="before">
                <field name="od_worked_on"
                       invisible="not holiday_status_id.is_od_comp_off"
                       readonly="state in ['cancel','refuse','validate','validate1']"/>
            </xpath>

        </field>
    </record>
</odoo>
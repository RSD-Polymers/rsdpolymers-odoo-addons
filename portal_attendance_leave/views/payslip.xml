<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_custom_payslip_report" model="ir.actions.report">
        <field name="name">Custom Payslip</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>

        <!-- QWeb template name -->
        <field name="report_name">portal_attendance_leave.report_custom_payslip</field>
        <field name="report_file">portal_attendance_leave.report_custom_payslip</field>

        <!-- Allows printing from hr.payslip form -->
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>

        <field name="print_report_name">'Payslip - %s' % (object.number or object.name)</field>
    </record>
    <template id="report_custom_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">

                <!-- TOTAL ALLOCATED COMP-OFF -->
                <t t-set="total_comp_off_alloc"
                   t-value="sum(request.env['hr.leave.allocation'].sudo().search([
                        ('employee_id', '=', doc.employee_id.id),
                        ('state', '=', 'validate'),
                        ('holiday_status_id.name', '=', 'Comp Off'),
                   ]).mapped('number_of_days'))"/>

                <!-- COMP-OFF TAKEN THIS PERIOD -->
                <t t-set="comp_off_taken"
                   t-value="request.env['hr.leave'].sudo().search_count([
                        ('employee_id', '=', doc.employee_id.id),
                        ('state', '=', 'validate'),
                        ('holiday_status_id.name', '=', 'Comp Off'),
                        ('request_date_from', '>=', doc.date_from),
                        ('request_date_to', '&lt;=', doc.date_to),
                   ])"/>

                <!-- COMP-OFF BALANCE -->
                <t t-set="comp_off_balance"
                   t-value="total_comp_off_alloc - comp_off_taken"/>

                <div style="font-family:Arial, sans-serif; font-size:13px; width:800px; margin:auto; border:1px solid #000; padding:15px; background:#fff;">

                    <!-- Header -->
                    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #000; padding-bottom:8px; margin-bottom:10px;">
                        <img t-att-src="request.httprequest.host_url + '/portal_attendance_leave/static/src/img/img.png'"
                             style="width:110px;"/>

                        <div style="text-align:center;">
                            <h2 style="margin:0; font-size:18px;">RSD Polymers Pvt. Ltd.</h2>
                            <p style="margin:2px 0; font-size:12px;">
                                Sanjar Enclave, Office No. 601, Khahuria Tank Lane, Off. S. V. Road, Opp. PVR Milap
                                Cinema,
                                <br/>
                                Kandivali West, Mumbai, Maharashtra 400067
                            </p>
                        </div>
                    </div>

                    <!-- Title -->
                    <div style="text-align:center; font-weight:bold; margin:8px 0; text-decoration:underline;">
                        Payslip for the Month of
                        <t t-esc="doc.date_from.strftime('%B %Y')"/>
                    </div>

                    <!-- Employee Info -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:10px;">
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Employee ID</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.barcode"/>
                            </td>
                            <td style="border:1px solid #000; padding:5px;">UAN</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.uan"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Employee Name</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.name"/>
                            </td>
                            <td style="border:1px solid #000; padding:5px;">PF No</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.pf_number"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Designation</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.job_id.name"/>
                            </td>
                            <td style="border:1px solid #000; padding:5px;">ESI No</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.esi_number"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Department</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.department_id.name"/>
                            </td>
                            <td style="border:1px solid #000; padding:5px;">Bank</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.bank_account_id.name if doc.employee_id.bank_account_id else 'HDFC'"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Date of Joining</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.date_of_joining.strftime('%d-%b-%Y')"/>
                            </td>
                            <td style="border:1px solid #000; padding:5px;">Account No</td>
                            <td style="border:1px solid #000; padding:5px;">
                                <t t-esc="doc.employee_id.account_number"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Working Days -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:10px;">

                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Total Working Days</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % doc.number_of_days"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Paid Days</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % doc.leaves"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Weekly Offs</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % doc.weakoff"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Present Days</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (doc.number_of_days - doc.leaves - doc.weakoff)"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Leaves Taken</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % doc.leaves"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Balance Paid Leaves</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">0.00</td>
                        </tr>

                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Comp. Off Taken</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (comp_off_taken if comp_off_taken else 0)"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Comp Off. Bal</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (comp_off_balance if comp_off_balance else 0)"/>
                            </td>
                        </tr>

                    </table>

                    <!-- Earnings & Deductions -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:10px;">
                        <tr>
                            <th colspan="2" style="border:1px solid #000; padding:5px; background:#f2f2f2;">Earnings
                            </th>
                            <th colspan="2" style="border:1px solid #000; padding:5px; background:#f2f2f2;">Deductions
                            </th>
                        </tr>

                        <!-- BASIC / PF -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Basic</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Basic Salary'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Provident Fund (PF)</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='PF'))"/>
                            </td>
                        </tr>

                        <!-- HRA / ESI -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">HRA</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='HRA'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">ESI</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='ESIC'))"/>
                            </td>
                        </tr>

                        <!-- Conveyance / Professional Tax -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Conveyance Allowance</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='CONVEYANCE'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Professional Tax</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Profession Tax'))"/>
                            </td>
                        </tr>

                        <!-- Medical / TDS -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Medical Allowance</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='MEDICAL REIMB.'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">TDS</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='TDS'))"/>
                            </td>
                        </tr>

                        <!-- Others / Advance -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Other Allowances</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='OTH ALL'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Advance</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Advance'))"/>
                            </td>
                        </tr>

                        <!-- OT / Loan -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">Over Time (OT)</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Over Time'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px;">Loan</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Loan'))"/>
                            </td>
                        </tr>

                        <!-- DA -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px;">DA</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='DA'))"/>
                            </td>
                            <td style="border:1px solid #000; padding:5px;"></td>
                            <td style="border:1px solid #000; padding:5px;"></td>
                        </tr>

                        <!-- Totals -->
                        <tr>
                            <td style="border:1px solid #000; padding:5px; font-weight:bold;">Total Earnings</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right; font-weight:bold;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Taxable Salary'))"/>
                            </td>

                            <td style="border:1px solid #000; padding:5px; font-weight:bold;">Total Deductions</td>
                            <td style="border:1px solid #000; padding:5px; text-align:right; font-weight:bold;">
                                <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name in ['Basic Salary','PF','ESIC','Profession Tax','TDS','Advance','Loan']))"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Net Salary -->
                    <div style="font-weight:bold; border-top:2px solid #000; padding-top:6px; margin-top:8px;">
                        Net Salary:
                        <t t-esc="'%.2f' % (sum(line.amount for line in doc.line_ids if line.name=='Net Salary'))"/>
                    </div>

                    <div style="margin-top:10px; font-size:12px; font-weight:bold;">
                        Net Salary in Words:
                        <t t-esc="doc.employee_id.currency_id.amount_to_text(sum(line.amount for line in doc.line_ids if line.name=='Net Salary'))"/>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>

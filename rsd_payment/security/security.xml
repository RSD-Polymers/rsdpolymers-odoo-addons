<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_rsd_payment_accounts" model="res.groups">
        <field name="name">Payment Desk - Accounts</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_rsd_payment_finance" model="res.groups">
        <field name="name">Payment Desk - Finance</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_rsd_payment_hod" model="res.groups">
        <field name="name">Payment Desk - HOD</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="rule_rsd_expense_accounts_read" model="ir.rule">
        <field name="name">Payment Desk Accounts - Involved Expense Reports</field>
        <field name="model_id" ref="hr_expense.model_hr_expense_sheet"/>
        <field name="groups" eval="[(4, ref('rsd_payment.group_rsd_payment_accounts'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="domain_force">[('rsd_accounts_involved', '=', True)]</field>
    </record>

    <record id="rule_rsd_expense_finance_read" model="ir.rule">
        <field name="name">Payment Desk Finance - Involved Expense Reports</field>
        <field name="model_id" ref="hr_expense.model_hr_expense_sheet"/>
        <field name="groups" eval="[(4, ref('rsd_payment.group_rsd_payment_finance'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="domain_force">[('rsd_finance_involved', '=', True)]</field>
    </record>

    <record id="rule_rsd_payment_hod_read" model="ir.rule">
        <field name="name">Payment Desk HOD - All Payments</field>
        <field name="model_id" ref="model_rsd_payment"/>
        <field name="groups" eval="[(4, ref('rsd_payment.group_rsd_payment_hod'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

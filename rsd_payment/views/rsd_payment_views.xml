<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rsd_payment_list" model="ir.ui.view">
        <field name="name">rsd.payment.list</field>
        <field name="model">rsd.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="expense_sheet_id"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="approval_date"/>
                <field name="payment_date"/>
                <field name="state"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="view_rsd_payment_form" model="ir.ui.view">
        <field name="name">rsd.payment.form</field>
        <field name="model">rsd.payment</field>
        <field name="arch" type="xml">
            <form string="RSD Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="expense_sheet_id"/>
                            <field name="employee_id"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="approval_date"/>
                            <field name="payment_date"/>
                            <field name="state"/>
                            <field name="created_by"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rsd_payment" model="ir.actions.act_window">
        <field name="name">RSD Payments</field>
        <field name="res_model">rsd.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rsd_payment_list"/>
        <field name="groups_id" eval="[(4, ref('rsd_payment.group_rsd_payment_accounts')), (4, ref('rsd_payment.group_rsd_payment_finance'))]"/>
    </record>
</odoo>

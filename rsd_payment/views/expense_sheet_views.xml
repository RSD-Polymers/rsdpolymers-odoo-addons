<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_expense_sheet_form_rsd_payment" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.rsd.payment</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_rsd_send_to_finance"
                        string="Send to Finance"
                        type="object"
                        class="oe_highlight"
                        groups="rsd_payment.group_rsd_payment_accounts"
                        invisible="rsd_payment_state != 'accounts_review'"/>

                <button name="%(action_rsd_finance_approval_wizard)d"
                        string="Approve"
                        type="action"
                        class="oe_highlight"
                        groups="rsd_payment.group_rsd_payment_finance"
                        invisible="rsd_payment_state != 'finance_review'"/>

                <button name="%(action_rsd_finance_send_back_wizard)d"
                        string="Send Back"
                        type="action"
                        groups="rsd_payment.group_rsd_payment_finance"
                        invisible="rsd_payment_state != 'finance_review'"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="RSD Payment"
                       invisible="rsd_payment_state == False"
                       groups="rsd_payment.group_rsd_payment_accounts,rsd_payment.group_rsd_payment_finance">
                    <field name="rsd_payment_state" readonly="1"/>
                    <field name="rsd_payment_id" readonly="1"
                           invisible="not rsd_payment_id"/>
                    <field name="rsd_send_back_reason"
                           readonly="1"
                           invisible="not rsd_send_back_reason"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>

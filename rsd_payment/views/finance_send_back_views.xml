<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rsd_finance_send_back_wizard" model="ir.ui.view">
        <field name="name">rsd.finance.send.back.wizard.form</field>
        <field name="model">rsd.finance.send.back.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Back to Accounts">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_send_back"
                            string="Send Back"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rsd_finance_send_back_wizard" model="ir.actions.act_window">
        <field name="name">Send Back to Accounts</field>
        <field name="res_model">rsd.finance.send.back.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rsd_finance_send_back_wizard"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense_sheet"/>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('rsd_payment.group_rsd_payment_finance'))]"/>
    </record>
</odoo>

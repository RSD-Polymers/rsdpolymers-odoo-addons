<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_daily_gdrive_backup" model="ir.cron">
            <field name="name">Daily PostgreSQL DB Backup to Google Drive</field>
            <field name="model_id" ref="model_gdrive_backup_config"/>
            <field name="state">code</field>
            <field name="code">
                model.sudo().run_cron_backup()
            </field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=17, minute=30) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

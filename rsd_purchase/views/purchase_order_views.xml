<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_inherit_work_order" model="ir.ui.view">
        <field name="name">purchase.order.form.work.order</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='print_quotation']" position="attributes" multiple="1">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_rfq_send']" position="attributes" multiple="1">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="is_work_order" readonly="state in ['cancel', 'done', 'purchase']"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="ship_to_address_id" readonly="state in ['cancel', 'done', 'purchase']"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="other_references" readonly="state in ['cancel', 'done', 'purchase']"/>
                <field name="dispatch_through" readonly="state in ['cancel', 'done', 'purchase']"/>
                <field name="delivery_terms" readonly="state in ['cancel', 'done', 'purchase']"/>
            </xpath>
        </field>
    </record>
</odoo>
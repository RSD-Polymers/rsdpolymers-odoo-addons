<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_grn" model="ir.actions.report">
        <field name="name">Print GRN</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rsd_purchase.report_custom_grn</field>
        <field name="report_file">rsd_purchase.report_custom_grn</field>
        <field name="print_report_name">'GRN - %s' % (object.name)</field>
    </record>

    <template id="report_custom_grn">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="rsd_purchase.standard_grn_layout"/>
            </t>
        </t>
    </template>

    <template id="standard_grn_layout">
        <t t-set="o" t-value="o"/>
        <t t-call="web.external_layout">
            <div class="page" style="font-size:12px; font-family: DejaVu Sans, sans-serif;">
                <div class="oe_structure"/>
                <t>
                    <h2 class="text-center" style="margin-bottom:10px;">RECEIPT NOTE</h2>
                </t>

                <t t-set="po" t-value="env['purchase.order'].search([('name', '=', o.origin)], limit=1)"/>

                <table style="width:100%; font-size:12px; border-collapse:collapse; border:1px solid black;">
                    <tbody>
                        <tr>
                            <td style="width:50%; padding: 0; border-right:1px solid black; vertical-align: top;">

                                <table style="width:100%; border-collapse: separate; table-layout: fixed;">

                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black;">
                                            Invoice To
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black; vertical-align: top;">
                                            <p style="margin-bottom: 5px;">
                                                <span t-field="o.company_id.partner_id.name"
                                                      style="font-weight: bold;"/>
                                                <div t-field="o.company_id.partner_id"
                                                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                                E-mail:
                                                <span t-field="o.company_id.email"/>
                                                <br/>
                                                <span>GSTIN/UIN:</span>
                                                <span t-field="o.company_id.vat"/>
                                                <br/>
                                                <span>State Name:</span>
                                                <span t-field="o.company_id.state_id.name"/>
                                                <br/>
                                                <span>State Code:</span>
                                                <span t-field="o.company_id.state_id.l10n_in_tin"/>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black;">
                                            Consignee (Ship To)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; vertical-align: top; border-bottom: none;">
                                            <span t-field="po.ship_to_address_id.name" style="font-weight: bold;"/>
                                            <div t-field="po.ship_to_address_id"
                                                 t-options='{"widget": "contact", "fields":["address"], "no_marker": True}'/>
                                            <span>E-mail:</span>
                                            <span t-field="po.ship_to_address_id.email"/>
                                            <br/>
                                            <span>GSTIN/UIN:</span>
                                            <span t-field="po.ship_to_address_id.vat"/>
                                            <br/>
                                            <span>State Name:</span>
                                            <span t-field="po.ship_to_address_id.state_id.name"/>
                                            <br/>
                                            <span>State Code:</span>
                                            <span t-field="po.ship_to_address_id.state_id.l10n_in_tin"/>
                                        </td>
                                    </tr>

                                </table>

                            </td>

                            <td style="width:50%; padding: 0; vertical-align: top;">

                                <table style="width:100%; border-collapse: separate; table-layout: fixed;">

                                    <tr>
                                        <td style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                            Receipt Note No
                                        </td>
                                        <td style="width:50%; padding: 5px; border-bottom:1px solid black;">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                            Date
                                        </td>
                                        <td style="width:50%; padding: 5px; border-bottom:1px solid black;">
                                            <span t-field="o.date_done" t-options='{"widget": "date"}'/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                            PO No. / Reference No. &amp; Date.
                                        </td>
                                        <td style="width:50%; padding: 5px; border-bottom:1px solid black;">
                                            <span t-field="o.origin"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                            Other References
                                        </td>
                                        <td style="width:50%; padding: 5px; border-bottom:1px solid black;">
                                            <span t-field="o.note"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                            Destination
                                        </td>
                                        <td style="width:50%; padding: 5px; border-bottom:1px solid black;">
                                            <span t-field="po.ship_to_address_id.street"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td colspan="2" style="padding: 5px; border-bottom:1px solid black;">
                                            Supplier / Bill From
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2"
                                            style="padding: 5px; vertical-align: top; border-bottom: 5px solid white;">
                                            <span t-field="o.partner_id.name" style="font-weight: bold;"/>
                                            <div t-field="o.partner_id"
                                                 t-options='{"widget": "contact", "fields":["address"], "no_marker": True}'/>
                                            <span>GSTIN/UIN:</span>
                                            <span t-field="o.partner_id.vat"/>
                                            <br/>
                                            <span>State Name:</span>
                                            <span t-field="o.partner_id.state_id.name"/>
                                            <br/>
                                            <span>State Code:</span>
                                            <span t-field="o.partner_id.state_id.l10n_in_tin"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table style="width:100%; border-collapse:collapse; border:1px solid black; page-break-inside: auto; font-size: 12px;">
                    <thead>
                        <tr style="background-color:#F5F5F5;">
                            <th style="width:5%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                Sr.No.
                            </th>
                            <th style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                Description of Goods
                            </th>
                            <th style="width:15%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                Quantity
                            </th>
                            <th style="width:10%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                Rate
                            </th>
                            <th style="width:10%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                Per
                            </th>
                            <th style="width:10%; padding: 5px; border-bottom:1px solid black;">
                                Amount
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="current_line" t-value="1"/>
                        <t t-foreach="o.move_ids.filtered(lambda x: x.state != 'cancel')" t-as="move">
                            <tr>
                                <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black; text-align:center;">
                                    <span t-esc="current_line"/>
                                    <t t-set="current_line" t-value="current_line + 1"/>
                                </td>
                                <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                    <span t-field="move.product_id.display_name"/>
                                </td>
                                <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black; text-align:right;">
                                    <span t-field="move.quantity"/>
                                </td>
                                <t t-set="po_line" t-value="move.purchase_line_id"/>

                                <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black; text-align:right;">
                                    <span t-field="po_line.price_unit"
                                          t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                </td>
                                <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black; text-align:center;">
                                    <span t-field="po_line.product_uom.name"/>
                                </td>
                                <td style="padding: 5px; border-bottom:1px solid black; text-align:right;">
                                    <t t-if="po_line">
                                        <span t-esc="move.quantity * po_line.price_unit"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </t>
                                </td>
                            </tr>
                        </t>

                        <tr>
                            <td colspan="5"
                                style="padding: 5px; border-right:1px solid black; text-align:right; font-weight:bold;">
                                Total
                            </td>
                            <td style="padding: 5px; text-align:right; font-weight:bold;">
                                <t t-set="total_amount" t-value="0"/>
                                <t t-foreach="o.move_ids.filtered(lambda x: x.state != 'cancel')" t-as="move">
                                    <t t-set="po_line" t-value="move.purchase_line_id"/>
                                    <t t-if="po_line">
                                        <t t-set="total_amount"
                                           t-value="total_amount + (move.quantity * po_line.price_unit)"/>
                                    </t>
                                </t>
                                <span t-esc="total_amount"
                                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table style="width:100%; font-size:12px; border-collapse:collapse; border-left:1px solid black; border-right:1px solid black; border-bottom:1px solid black;">
                    <tbody>
                        <tr>
                            <td style="width:60%; padding:10px; border-right:1px solid black; vertical-align:top;">
                                <span>Amount Chargeable (in words):</span>
                                <p>
                                    <strong>
                                        <span t-esc="o.company_id.currency_id.with_context(lang=o.partner_id.lang).amount_to_text(total_amount)"/>
                                        Only
                                    </strong>
                                </p>
                            </td>
                            <td style="width:40%; padding:10px; text-align:right; vertical-align:top;">
                                <p>E. &amp; O.E.</p>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:60%; padding:10px; border-right:1px solid black; vertical-align:bottom; min-height:100px;">
                                <p style="margin-top:5px;">
                                    Company's GSTIN/UIN:
                                    <span t-field="o.company_id.vat"/>
                                    <br/>
                                    Company's VAT TIN:
                                    <span t-field="o.company_id.company_registry"/>
                                    <br/>
                                    Company's PAN:
                                    <span t-field="o.company_id.vat"/>
                                </p>
                            </td>
                            <td style="width:40%; padding:10px; text-align:right; vertical-align:bottom; min-height:100px;">
                                <p style="margin:0 0 5px 0;">for
                                    <span t-field="o.company_id.name"/>
                                </p>
                                <span style="display:inline-block; border-top:1px solid black; padding-top:3px; min-width:80%; text-align:center;">
                                    Authorised Signatory
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="text-center" style="margin-top:10px; font-size:10px;">
                    This is a Computer Generated Document
                </p>
            </div>
        </t>
    </template>
</odoo>
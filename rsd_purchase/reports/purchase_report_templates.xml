<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-set="o" t-value="o or doc"/>
            <t t-call="rsd_purchase.standard_po_layout"/>
        </xpath>
    </template>

    <template id="standard_po_layout">
        <t t-set="o" t-value="o"/>

        <t t-set="company_address" t-value="False"/>

        <t t-call="web.external_layout">
            <t t-set="company_address" t-value="False"/>

            <div class="page" style="font-size:12px; font-family: DejaVu Sans, sans-serif;">

                <!-- TITLE -->
                <t t-if="o.is_work_order">
                    <h2 class="text-center" style="margin-bottom:10px;">WORK ORDER</h2>
                </t>
                <t t-else="">
                    <h2 class="text-center" style="margin-bottom:10px;">PURCHASE ORDER</h2>
                </t>

                <!-- TOP BLOCK (RESTORED ORIGINAL LAYOUT) -->
                <table style="width:100%; font-size:12px; border-collapse:collapse; border:1px solid black;">
                    <tbody>

                        <tr>
                            <td colspan="3"
                                style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                Invoice To
                            </td>
                            <td style="width:25%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>
                                    <t t-if="o.is_work_order">Work Order No.</t>
                                    <t t-else="">Purchase Order No.</t>
                                </strong>
                            </td>
                            <td style="width:25%; padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.name"/>
                            </td>
                        </tr>

                        <tr>
                            <td rowspan="5" colspan="3"
                                style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black; vertical-align: top;">
                                <p style="margin-bottom: 5px;">
                                    <span t-field="o.company_id.partner_id.name" style="font-weight: bold;"/>
                                    <div t-field="o.company_id.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                    <strong>E-mail:</strong>
                                    <span t-field="o.company_id.email"/>
                                    <br/>
                                    <span>GSTIN/UIN:</span>
                                    <span t-field="o.company_id.vat"/>
                                    <br/>
                                    <span>State Name:</span>
                                    <span t-field="o.company_id.state_id.name"/>
                                    <br/>
                                    <span>State Code:</span>
                                    <span t-field="o.company_id.state_id.l10n_in_tin"/>
                                </p>
                            </td>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Date</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Mode/Terms of Payment</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.payment_term_id.name"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Reference No. &amp; Date</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.partner_ref"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Other References</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.other_references"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Vendor Currency</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.currency_id.name"/>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="3"
                                rowspan="4"
                                style="width:50%; padding: 0; border-right:1px solid black; vertical-align: top;">

                                <table style="width:100%; border-collapse: collapse; table-layout: fixed;">
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black;">
                                            <span>Consignee (Ship To)</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black; vertical-align: top;">
                                            <span t-field="o.ship_to_address_id.name" style="font-weight: bold;"/>
                                            <div t-field="o.ship_to_address_id"
                                                 t-options='{"widget": "contact", "fields":["address"], "no_marker": True}'/>
                                            <span>E-mail:</span>
                                            <span t-field="o.ship_to_address_id.email"/>
                                            <br/>
                                            <span>GSTIN/UIN:</span>
                                            <span t-field="o.ship_to_address_id.vat"/>
                                            <br/>
                                            <span>State Name:</span>
                                            <span t-field="o.ship_to_address_id.state_id.name"/>
                                            <br/>
                                            <span>State Code:</span>
                                            <span t-field="o.ship_to_address_id.state_id.l10n_in_tin"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black;">
                                            <span>Supplier / Bill From</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; vertical-align: top;">
                                            <span t-field="o.partner_id.name" style="font-weight: bold;"/>
                                            <div t-field="o.partner_id"
                                                 t-options='{"widget": "contact", "fields":["address"], "no_marker": True}'/>
                                            <span>GSTIN/UIN:</span>
                                            <span t-field="o.partner_id.vat"/>
                                            <br/>
                                            <span>State Name:</span>
                                            <span t-field="o.partner_id.state_id.name"/>
                                            <br/>
                                            <span>State Code:</span>
                                            <span t-field="o.partner_id.state_id.l10n_in_tin"/>
                                        </td>
                                    </tr>
                                </table>

                            </td>

                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Dispatched Through</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.dispatch_through"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <strong>Destination</strong>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <span t-field="o.ship_to_address_id.street"/>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" style="padding: 5px; border-right: 1px solid black;">
                                <strong>Terms of Delivery</strong>
                                <br/>
                                <span t-field="o.delivery_terms"/>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" style="padding: 5px; border-right: 1px solid black;">
                            </td>
                        </tr>

                    </tbody>
                </table>
                <!-- PRODUCT AND TOTALS TABLE (COMBINED SECTION) -->
                <table style="width:100%; font-size:12px; border-collapse:collapse; border-left:1px solid black; border-right:1px solid black;">
                    <thead>
                        <tr style="font-weight: bold;">
                            <th class="text-center"
                                style="width:5%; border-right:1px solid black; padding: 5px; border-bottom:1px solid black;">
                                Sl No
                            </th>
                            <th style="width:35%; border-right:1px solid black; padding: 5px; border-bottom:1px solid black;">
                                Description of Goods
                            </th>
                            <th class="text-right"
                                style="width:10%; border-right:1px solid black; padding: 5px; border-bottom:1px solid black; text-align: right;">
                                Quantity
                            </th>
                            <th class="text-right"
                                style="width:10%; border-right:1px solid black; padding: 5px; border-bottom:1px solid black; text-align: right;">
                                Rate
                            </th>
                            <th class="text-right"
                                style="width:10%; border-right:1px solid black; padding: 5px; border-bottom:1px solid black; text-align: right;">
                                Per
                            </th>
                            <th class="text-right"
                                style="width:20%; padding: 5px; border-bottom:1px solid black; text-align: right;">
                                Amount
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="line_num" t-value="1"/>
                        <t t-foreach="o.order_line" t-as="line">
                            <tr style="border-bottom:1px solid black;">
                                <td class="text-center" style="border-right:1px solid black; padding: 5px;">
                                    <span t-esc="line_num"/>
                                </td>
                                <td style="border-right:1px solid black; padding: 5px;">
                                    <span t-field="line.name"/>
                                    <t t-if="line.product_id.description_purchase">
                                        <br/>
                                        <span t-field="line.product_id.description_purchase"/>
                                    </t>
                                </td>
                                <td class="text-right"
                                    style="border-right:1px solid black; padding: 5px; text-align: right;">
                                    <span t-field="line.product_qty"/>
                                </td>
                                <td class="text-right"
                                    style="border-right:1px solid black; padding: 5px; text-align: right;">
                                    <span t-field="line.price_unit"
                                          t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-right"
                                    style="border-right:1px solid black; padding: 5px; text-align: right;">
                                    <span t-field="line.product_uom.name"/>
                                </td>
                                <td class="text-right" style="padding: 5px; text-align: right;">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <t t-set="line_num" t-value="line_num + 1"/>
                        </t>

                        <t t-set="tax_groups" t-value="{}"/>
                        <t t-foreach="o.order_line" t-as="line">
                            <t t-set="computed"
                               t-value="line.taxes_id.compute_all(
       line.price_unit,
       o.currency_id,
       line.product_qty,
       product=line.product_id,
       partner=o.partner_id
    )"/>
                            <t t-set="line_taxes" t-value="computed.get('taxes', [])"/>

                            <t t-foreach="line_taxes" t-as="tax_item">
                                <t t-set="t_name" t-value="tax_item.get('name')"/>
                                <t t-set="t_amount" t-value="tax_item.get('amount', 0.0)"/>
                                <t t-set="existing" t-value="tax_groups.get(t_name, 0.0)"/>
                                <t t-set="tax_groups" t-value="dict(tax_groups, **{t_name: (existing + t_amount)})"/>
                            </t>
                        </t>

                        <tr>
                            <td colspan="4" style=""></td>
                            <td class="text-right" style="padding: 5px; text-align: right;">
                                <strong>Untaxed Amount</strong>
                            </td>
                            <td class="text-right" style="padding: 5px; text-align: right;">
                                <t t-esc="('%s %s' % (o.currency_id.symbol or '', '{:,.2f}'.format(o.amount_untaxed or 0.0)))"/>
                            </td>
                        </tr>


                        <t t-foreach="sorted(tax_groups.items(), key=lambda x: x[0])" t-as="pair">
                            <t t-set="tname" t-value="pair[0]"/>
                            <t t-set="tamt" t-value="pair[1]"/>

                            <tr>
                                <td colspan="4" style=""></td>
                                <td class="text-right" style="padding: 5px; text-align: right;">
                                    <strong>
                                        <t t-esc="tname"/>
                                    </strong>
                                </td>
                                <td class="text-right" style="padding: 5px; text-align: right;">
                                    <t t-esc="('%s %s' % (o.currency_id.symbol or '', '{:,.2f}'.format(tamt)))"/>
                                </td>
                            </tr>
                        </t>

                        <tr style="border-top:1px solid black; border-bottom:1px solid black;">
                            <td colspan="4" style=""></td>
                            <td class="text-right" style="padding: 5px; text-align: right;">
                                <strong>Total</strong>
                            </td>
                            <td class="text-right" style="padding: 5px; text-align: right;">
                                <span t-field="o.amount_total"
                                      t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
                            </td>
                        </tr>


                    </tbody>
                </table>
                <!-- FOOTER BLOCK -->
                <table style="width:100%; font-size:12px; border-collapse:collapse; border-left:1px solid black; border-right:1px solid black; border-bottom:1px solid black;">
                    <tbody>
                        <tr>
                            <td style="width:75%; padding:10px; border-right:1px solid black; vertical-align:top;">
                                <span>Amount Chargeable (in words):</span>
                                <p>
                                    <strong>
                                        <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                                        Only
                                    </strong>
                                </p>
                            </td>
                            <td style="width:25%; padding:10px; text-align:right; vertical-align:top;">
                                <p>E. &amp; O.E.</p>
                            </td>
                        </tr>

                        <tr>
                            <td style="width:75%; padding:10px; border-right:1px solid black; vertical-align:bottom; min-height:100px;">
                                <p style="margin-top:5px;">
                                    Company's GSTIN/UIN:
                                    <span t-field="o.company_id.vat"/>
                                    <br/>
                                    Company's VAT TIN:
                                    <span t-field="o.company_id.company_registry"/>
                                    <br/>
                                    Company's PAN:
                                    <span t-field="o.company_id.partner_id.l10n_in_pan"/>
                                </p>
                            </td>

                            <td style="width:25%; padding:10px; text-align:right; vertical-align:bottom;">
                                <div style="margin-top:50px;">
                                    <p style="margin:0; white-space:nowrap;">for
                                        <span t-field="o.company_id.name"/>
                                    </p>
                                    <p style="margin:5px 0 0 0; border-top:1px solid black; display:inline-block;
                                              padding-top:3px; min-width:80%; text-align:center;">
                                        Authorised Signatory
                                    </p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p class="text-center" style="margin-top:10px; font-size:10px;">
                    This is a Computer Generated Document
                </p>

            </div>
        </t>
    </template>

</odoo>
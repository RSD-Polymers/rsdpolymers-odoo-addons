<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_reject_wizard_form_view" model="ir.ui.view">
        <field name="name">project.task.reject.wizard.form</field>
        <field name="model">project.task.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason for Rejection">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="rejection_reason" required="1" widget="textarea"/>
                </group>
                <footer>
                    <button string="Reject Task" name="action_reject_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<odoo>
    <record id="view_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="checker_id" widget="res_partner_many2one" readonly="is_assignees_group_member == True" options="{'no_open': True}"/>
                <field name="is_assignees_group_member" invisible="1"/>
            </xpath>
            <xpath expr="//group/group[2]" position="inside">
                <field name="is_assigner_field" invisible="1"/>
                <field name="is_checker_field" invisible="1"/>

                <field name="marks_obtained" string="Marks Obtained (out of 100)"
                       readonly="is_checker_field == False" colspan="2"/>
                <field name="allowed_attempts" readonly="not (is_assigner_field or is_checker_field)" colspan="2"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
            </xpath>
            <xpath expr="//h1/div/field[@name='name']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
            </xpath>
            <xpath expr="//div[@name='project']/field[@name='project_id']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='milestone_id']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
            <xpath expr="//h1/div/field[@name='priority']" position="attributes">
                <attribute name="readonly">is_assignees_group_member</attribute>
            </xpath>
        </field>
    </record>
</odoo>
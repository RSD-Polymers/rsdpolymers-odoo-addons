<odoo>
    <record model="ir.ui.view" id="view_task_form_custom_allocated_hours">
        <field name="name">project.task.form.custom.allocated.hours</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='allocated_hours']" position="replace">
                <label for="allocated_hours" groups="hr_timesheet.group_hr_timesheet_user"/>
            </xpath>
            <xpath expr="//div[hasclass('text-nowrap') and contains(@invisible, 'allow_timesheets')]"
                   position="replace">
                <div class="text-nowrap" groups="hr_timesheet.group_hr_timesheet_user">
                    <field name="allocated_hours" class="oe_inline o_field_float_time o_task_planned_hours"
                           widget="timesheet_uom_no_toggle"/>
                    <span invisible="subtask_count == 0">
                        (incl.
                        <field name="subtask_allocated_hours" nolabel="1" widget="timesheet_uom_no_toggle"
                               class="oe_inline"/>
                        on
                        <span class="fw-bold text-dark">Sub-tasks</span>)
                    </span>
                    (<field name="progress" invisible="not project_id" class="oe_inline" nolabel="1"
                            decoration-danger="progress &gt; 1.005" digits="[1, 0]" widget="percentage"/>)
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="is_admin_user" invisible="1"/>
                <field name="is_current_user_the_task_checker" invisible="1"/>
                <field name="is_current_user_the_task_assignee" invisible="1"/>
                <field name="is_editable_to_user" invisible="1"/>
                <field name="checker_id" widget="res_partner_many2one"
                       readonly="(is_editable_to_user == False) or is_locked" options="{'no_open': True}"/>
                <field name="is_assignees_group_member" invisible="1"/>
            </xpath>
            <xpath expr="//group/group[2]" position="inside">
                <field name="is_assigner_field" invisible="1"/>
                <field name="is_checker_field" invisible="1"/>
                <field name="is_locked" invisible="1"/>
                <field name="marks_obtained" string="Marks Obtained (out of 100)"
                       readonly="is_rejected or is_locked or is_current_user_the_task_checker == False"/>
                <field name="allowed_attempts"
                       readonly="id != False and (is_editable_to_user == False or (not (is_assigner_field or is_checker_field)) or is_locked)"
                       colspan="2"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_accept_task" type="object" string="Accept"
                        class="oe_highlight"
                        invisible="not can_assignee_accept_reject"/>
                <button name="action_reject_task" type="object" string="Reject"
                        class="btn-secondary"
                        invisible="not can_assignee_accept_reject"/>
            </xpath>

            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
            </xpath>
            <xpath expr="//h1/div/field[@name='name']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
            </xpath>
            <xpath expr="//div[@name='project']/field[@name='project_id']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='milestone_id']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
            <xpath expr="//h1/div/field[@name='priority']" position="attributes">
                <attribute name="readonly">not is_editable_to_user or is_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="rejection_remarks" invisible="not is_rejected"/>
            </xpath>

            <!-- Set readonly="is_locked" on all fields inside notebook pages -->
            <xpath expr="//page[@name='description_page']/field[@name='description']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='page_timesheets']/field[@name='timesheet_ids']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']/field[@name='child_ids']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='parent_id']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='company_id']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='sequence']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='email_cc']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='displayed_image_id']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='date_assign']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='date_last_stage_update']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='working_hours_open']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='working_days_open']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='working_hours_close']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']//field[@name='working_days_close']" position="attributes">
                <attribute name="readonly">is_editable_to_user == False or is_locked</attribute>
            </xpath>
            <!-- Set readonly="is_locked" on all fields inside notebook pages -->

        </field>
    </record>

    <record id="project_custom_hide_timer_buttons" model="ir.ui.view">
        <field name="name">project.task.form.hide.timer.buttons.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="timesheet_grid.project_task_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_timer_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_timer_stop']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_timer_pause']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_timer_resume']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timer_start'][@widget='timer_start_field']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
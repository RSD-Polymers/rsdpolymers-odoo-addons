<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="project_task_rule_create_access" model="ir.rule">
            <field name="name">Project Task Creation Access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="project_task_rule_all_users" model="ir.rule">
            <field name="name">Project Task User Access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', '|', ('user_ids', 'in', user.id), ('checker_id', '=', user.id),
                ('message_follower_ids.partner_id', '=', user.partner_id.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="project_task_rule_nilesh_departments" model="ir.rule">
            <field name="name">Project Task Nilesh Access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
            <field name="domain_force" eval="[('user_ids.employee_ids.department_id', 'in', [
                    ref('hr.dep_qc'),
                    ref('hr.dep_qa'),
                    ref('hr.dep_store'),
                    ref('hr.dep_production')
                ])]"/>
        </record>

        <record id="project_task_rule_project_managers" model="ir.rule">
            <field name="name">Project Task Manager Access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
            <field name="domain_force">[('project_id.user_id', '=', user.id)]</field>
        </record>

        <record id="project_task_rule_admin" model="ir.rule">
            <field name="name">Project Task Admin Access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
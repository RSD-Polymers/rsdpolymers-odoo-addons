<odoo>

    <!-- ====================================================== -->
    <!-- Search View -->
    <!-- ====================================================== -->
    <record id="view_essl_attendance_log_search" model="ir.ui.view">
        <field name="name">essl.attendance.log.search</field>
        <field name="model">essl.attendance.log</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Logs">

                <field name="employee_id"
                       string="Employee"
                       filter_domain="[('employee_id.name', 'ilike', self)]"/>
                <field name="processed"/>
                <field name="status"/>

                <filter name="processed"
                        string="Processed"
                        domain="[('processed','=',True)]"/>

                <filter name="unprocessed"
                        string="Unprocessed"
                        domain="[('processed','=',False)]"/>

                <filter name="error"
                        string="Error"
                        domain="[('status','=','error')]"/>

                <filter string="Archived"
                        name="archived"
                        domain="[('active','=',False)]"/>

            </search>
        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Action -->
    <!-- ====================================================== -->
    <record id="action_essl_attendance_log" model="ir.actions.act_window">
        <field name="name">eSSL Attendance Logs</field>
        <field name="res_model">essl.attendance.log</field>
        <field name="view_mode">list,form</field>
        <field name="help">These are raw logs fetched from eSSL devices.</field>
    </record>

    <!-- ====================================================== -->
    <!-- Menu -->
    <!-- ====================================================== -->
    <menuitem id="menu_essl_attendance_root"
              name="eSSL Attendance"
              parent="hr_attendance.menu_hr_attendance_root"/>

    <menuitem id="menu_essl_attendance_log"
              name="Sync Logs"
              parent="menu_essl_attendance_root"
              action="action_essl_attendance_log"/>

    <!-- ====================================================== -->
    <!-- List View -->
    <!-- ====================================================== -->
    <record id="view_essl_attendance_log_list" model="ir.ui.view">
        <field name="name">essl.attendance.log.list</field>
        <field name="model">essl.attendance.log</field>
        <field name="arch" type="xml">
            <list string="eSSL Attendance Logs">
                <field name="employee_device_id"/>
                <field name="employee_id"/>
                <field name="punch_time_local"/>
                <field name="processed"/>
                <field name="raw_line"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Form View -->
    <!-- ====================================================== -->
    <record id="view_essl_attendance_log_form" model="ir.ui.view">
        <field name="name">essl.attendance.log.form</field>
        <field name="model">essl.attendance.log</field>
        <field name="arch" type="xml">
            <form string="eSSL Attendance Log">
                <sheet>
                    <field name="active" invisible="1"/>
                    <!-- ===== HEADER INFO ===== -->
                    <group string="Basic Information" col="2">
                        <field name="employee_device_id" readonly="1"/>
                        <field name="employee_id" readonly="1"/>
                    </group>

                    <!-- ===== PUNCH DETAILS ===== -->
                    <group string="Punch Details" col="2">
                        <field name="punch_time_local" readonly="1"/>
                        <field name="raw_line" readonly="1"/>
                    </group>

                    <!-- ===== PROCESSING STATUS ===== -->
                    <group string="Processing Status" col="2">
                        <field name="processed" readonly="1"/>
                        <field name="status" readonly="1"/>
                    </group>

                    <!-- ===== ERROR DETAILS ===== -->
                    <group string="Error Details">
                        <field name="error_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sync_essl_attendance" model="ir.cron">
            <field name="name">eSSL: Fetch Attendance Logs</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">
                model.sudo().sync_essl_attendance_logs()
            </field>
            <field name="interval_type">minutes</field>
            <field name="interval_number">5</field>
            <field name="nextcall"
                   eval="(DateTime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_process_essl_logs" model="ir.cron">
            <field name="name">eSSL: Process Attendance Logs</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.sudo().process_essl_attendance_logs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
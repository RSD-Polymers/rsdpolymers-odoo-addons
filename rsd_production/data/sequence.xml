<odoo>
    <record id="seq_rm_issue" model="ir.sequence">
        <field name="name">RM Issue</field>
        <field name="code">rm.issue</field>
        <field name="prefix">RMI/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_production_request" model="ir.sequence">
        <field name="name">Production Request</field>
        <field name="code">production.request</field>
        <field name="prefix">PR/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>

    <!--
        Current Indian financial year: 01-Apr-2026 to 31-Mar-2027.
        The custom ir.sequence override creates future FY ranges automatically.
    -->

    <record id="seq_rm_return" model="ir.sequence">
        <field name="name">RM Return</field>
        <field name="code">rm.return</field>
        <field name="prefix">RMR/%(year)s/</field>
        <field name="padding">4</field>
    </record>

</odoo>

<odoo>
    <template id="rsd_production.mo_finished_label_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="mo">
                <div class="page" style="width: 100%; font-family: Arial, sans-serif; color: #000000; box-sizing: border-box; page-break-after: always;">

                    <t t-set="net_wt" t-value="mo.product_id.weight or 0.0"/>
                    <t t-set="tare_wt" t-value="mo.tare_weight or 0.0"/>
                    <t t-set="gross_wt" t-value="net_wt + tare_wt"/>

                    <div style="border: 4px solid #000000; border-radius: 12px; padding: 15px; width: 100%; box-sizing: border-box;">

                        <table class="table-borderless" style="width: 100%; margin-bottom: 5px; border-collapse: collapse; border: none !important;" cellpadding="0" cellspacing="0">
                            <tr>
                                <td style="width: 25%; text-align: left; vertical-align: middle; border: none !important; padding: 0;">
                                    <img t-if="mo.company_id.logo"
                                         t-att-src="image_data_uri(mo.company_id.logo)"
                                         style="max-height: 60px; max-width: 100%; object-fit: contain;" alt="Company Logo"/>
                                </td>
                                <td style="width: 75%; font-size: 14px; font-weight: bold; line-height: 1.3; vertical-align: middle; border: none !important; padding-left: 10px;">
                                    <t t-esc="mo.company_id.street"/>, <t t-esc="mo.company_id.city"/> <t t-esc="mo.company_id.zip"/><br/>
                                    Email - <t t-esc="mo.company_id.email"/><br/>
                                    Web - <t t-esc="mo.company_id.website"/>
                                </td>
                            </tr>
                        </table>

                        <div style="border-top: 2px solid #000000; margin: 10px 0;"></div>

                        <div style="text-align: center; font-size: 26px; font-weight: 900; margin: 15px 0; letter-spacing: 0.5px;">
                            <t t-esc="mo.product_id.name"/>
                        </div>

                        <table class="table-borderless" style="width: 100%; font-size: 16px; border-collapse: collapse; border: none !important; margin-bottom: 0;" cellpadding="0" cellspacing="0">
                            <tr>
                                <td style="width: 22%; font-weight: bold; border: none !important; padding: 8px 5px; white-space: nowrap;">Batch No.</td>
                                <td style="width: 28%; font-weight: 900; border: none !important; padding: 8px 5px;"><t t-esc="mo.lot_producing_id.name"/></td>

                                <td style="width: 24%; font-weight: bold; border: none !important; padding: 8px 5px; white-space: nowrap;">Date of Mfg.</td>
                                <td style="width: 26%; font-weight: 900; border: none !important; padding: 8px 5px;">
                                    <t t-esc="mo.date_start.strftime('%b-%Y').upper() if mo.date_start else ''"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="font-weight: bold; border: none !important; padding: 8px 5px; white-space: nowrap;">Net. Wt.</td>
                                <td style="font-weight: 900; border: none !important; padding: 8px 5px;">
                                    <t t-esc="'%.2f' % net_wt"/> KG
                                </td>

                                <td style="font-weight: bold; border: none !important; padding: 8px 5px; white-space: nowrap;">Tare Wt.</td>
                                <td style="font-weight: 900; border: none !important; padding: 8px 5px;">
                                    <t t-esc="'%.2f' % tare_wt"/> KG
                                </td>
                            </tr>

                            <tr>
                                <td style="font-weight: bold; border: none !important; padding: 8px 5px; white-space: nowrap;">Gross Wt.</td>
                                <td style="font-weight: 900; border: none !important; padding: 8px 5px;">
                                    <t t-esc="'%.2f' % gross_wt"/> KG
                                </td>

                                <td style="font-weight: bold; border: none !important; padding: 8px 5px; vertical-align: middle; white-space: nowrap;">Packed by.</td>
                                <td style="font-weight: 900; border: none !important; padding: 8px 5px; vertical-align: middle;">
                                    <div style="border: 2px solid #000000; padding: 4px 10px; display: inline-block; text-align: center; font-size: 16px; min-width: 120px;">
                                        <t t-esc="mo.packed_by.name.split()[0] if mo.packed_by else ''"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table class="table-borderless" style="width: 100%; font-size: 15px; font-weight: bold; margin-top: 25px; border-collapse: collapse; border: none !important;" cellpadding="0" cellspacing="0">
                            <tr>
                                <td style="width: 50%; text-align: left; border: none !important; vertical-align: bottom; padding-left: 5px;">
                                    Prepared By :
                                    <span style="border-bottom: 2px solid #000000; display: inline-block; width: 140px; text-align: center; padding-bottom: 2px; margin-left: 5px;">
                                        <t t-esc="mo.prepared_by.name.split()[0] if mo.prepared_by else ''"/>
                                    </span>
                                </td>
                                <td style="width: 50%; text-align: right; border: none !important; vertical-align: bottom; padding-right: 5px;">
                                    Check by :
                                    <span style="border-bottom: 2px solid #000000; display: inline-block; width: 140px; text-align: center; padding-bottom: 2px; margin-left: 5px;">
                                        <t t-esc="mo.user_id.name.split()[0] if mo.user_id else ''"/>
                                    </span>
                                </td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_custom_delivery_challan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="rsd_production.standard_delivery_challan_layout"/>
            </t>
        </t>
    </template>

    <template id="standard_delivery_challan_layout">

        <t t-set="o" t-value="o"/>

        
        <t t-set="so" t-value="o.sale_id or env['sale.order'].search([('name','=',o.origin)], limit=1)"/>
        
        <t t-set="invoice"
           t-value="env['account.move'].search([
        ('move_type','=','out_invoice'),
        ('invoice_origin','ilike', o.origin)
            ], limit=1)"/>
        <t t-set="currency"
           t-value="(invoice and invoice.currency_id) or o.company_id.currency_id"/>
        
        <t t-set="shipping_partner" t-value="o.partner_id"/>
        <t t-set="billing_partner"
           t-value="so.partner_invoice_id if so and so.partner_invoice_id else o.partner_id"/>

        <t t-call="web.external_layout">
            <div class="page" style="font-size:12px; font-family: DejaVu Sans, sans-serif;">

                
                <div style="text-align:center; font-size:16px; font-weight:bold; margin-bottom:6px;">
                    DELIVERY CHALLAN
                </div>
                <br/>

                <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                    <tr>

                        
                        
                        <td style="width:55%; border-right:1px solid black; padding:0; vertical-align:top;">

                            <table style="width:100%; border-collapse:collapse;">

                                
                                <tr>
                                    <td style="padding:8px; border-bottom:1px solid black;">

                                        <b>
                                            <span t-field="o.company_id.name"/>
                                        </b>
                                        <br/>
                                        <span t-field="o.company_id.partner_id.street"/>
                                        <br/>
                                        <span t-field="o.company_id.partner_id.city"/>
                                        -
                                        <span t-field="o.company_id.partner_id.zip"/>
                                        <br/>
                                        GSTIN/UIN:
                                        <span t-field="o.company_id.vat"/>
                                        <br/>
                                        State Name:
                                        <span t-field="o.company_id.state_id.name"/>
                                        , Code :
                                        <span t-field="o.company_id.state_id.l10n_in_tin"/>
                                        <br/>
                                        E-Mail:
                                        <span t-field="o.company_id.email"/>

                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="padding:8px; border-bottom:1px solid black;">

                                        <b>Consignee (Ship to)</b>
                                        <br/>
                                        <b>
                                            <span t-field="shipping_partner.name"/>
                                        </b>
                                        <br/>
                                        <span t-field="shipping_partner.street"/>
                                        <br/>
                                        <span t-field="shipping_partner.city"/>
                                        -
                                        <span t-field="shipping_partner.zip"/>
                                        <br/>
                                        GSTIN/UIN:
                                        <span t-field="shipping_partner.vat"/>
                                        <br/>
                                        State Name:
                                        <span t-field="shipping_partner.state_id.name"/>
                                        , Code :
                                        <span t-field="shipping_partner.state_id.l10n_in_tin"/>

                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="padding:8px;">

                                        <b>Buyer (Bill to)</b>
                                        <br/>
                                        <b>
                                            <span t-field="billing_partner.name"/>
                                        </b>
                                        <br/>
                                        <span t-field="billing_partner.street"/>
                                        <br/>
                                        <span t-field="billing_partner.city"/>
                                        -
                                        <span t-field="billing_partner.zip"/>
                                        <br/>
                                        GSTIN/UIN:
                                        <span t-field="billing_partner.vat"/>
                                        <br/>
                                        State Name:
                                        <span t-field="billing_partner.state_id.name"/>
                                        , Code :
                                        <span t-field="billing_partner.state_id.l10n_in_tin"/>

                                    </td>
                                </tr>

                            </table>

                        </td>

                        
                        <td style="width:45%; padding:0; vertical-align:top;">

                            <table style="width:100%; border-collapse:collapse;">

                                
                                <tr>
                                    <td style="border-bottom:1px solid black; padding:6px;">
                                        Delivery Note No.
                                        <br/>
                                        <b t-esc="o.name"/>
                                    </td>

                                    <td style="border-left:1px solid black; border-bottom:1px solid black; padding:6px;">
                                        Dated
                                        <br/>
                                        <b>
                                            <span t-esc="o.scheduled_date and o.scheduled_date.strftime('%d-%b-%y').lstrip('0')"/>
                                        </b>
                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="border-bottom:1px solid black; padding:6px;">
                                        e-Way Bill No.
                                        <br/>
                                    </td>

                                    <td style="border-left:1px solid black; border-bottom:1px solid black; padding:6px;">
                                        Mode/Terms of Payment
                                        <br/>
                                        <b>
                                            <span t-esc="so.payment_term_id.name if so else ''"/>
                                        </b>
                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="border-bottom:1px solid black; padding:6px;">
                                        Buyer's Order No.
                                        <br/>
                                        <b t-esc="invoice.ref if invoice else ''"/>
                                    </td>

                                    <td style="border-left:1px solid black; border-bottom:1px solid black; padding:6px;">
                                        Other References
                                        <br/>
                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="padding:6px;">
                                        Reference No. &amp; Date
                                    </td>

                                    <td style="border-left:1px solid black; padding:6px;">
                                        <b>
                                            <span t-esc="so.client_order_ref if so else ''"/>
                                        </b>
                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="padding:6px;">
                                        Dispatch Doc No.
                                    </td>

                                    <td style="border-left:1px solid black; padding:6px;">
                                        <b>
                                            <span t-esc="invoice.dispatch_doc_no if invoice else ''"/>
                                        </b>
                                    </td>
                                </tr>

                                
                                <tr>
                                    <td style="border-bottom:1px solid black; padding:6px;">
                                        Dispatched through
                                        <br/>
                                        <b>
                                            <span t-esc="so.dispatch_through if so else ''"/>
                                        </b>
                                    </td>

                                    <td style="border-left:1px solid black; border-bottom:1px solid black; padding:6px;">
                                        Destination
                                        <br/>
                                        <b>
                                            <span t-esc="shipping_partner.city"/>
                                        </b>
                                    </td>
                                </tr>

                                
                                <tr>
                                    <td colspan="2" style="padding:6px;">
                                        Terms of Delivery
                                        <br/>
                                        <span t-esc="so.note if so else ''"/>
                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>
                </table>

                
                <table style="width:100%; border-left:1px solid black; border-right:1px solid black; border-bottom:1px solid black; border-collapse:collapse; margin-top:0;">

                    
                    <tr style="border-top:1px solid black;">
                        <th style="width:4%; border-right:1px solid black; padding:5px;">Sl</th>
                        <th style="width:36%; border-right:1px solid black; padding:5px;">Description of Goods</th>
                        <th style="width:12%; border-right:1px solid black; padding:5px;">HSN/SAC</th>
                        <th style="width:12%; border-right:1px solid black; padding:5px;">Quantity</th>
                        <th style="width:10%; border-right:1px solid black; padding:5px;">Rate</th>
                        <th style="width:8%; border-right:1px solid black; padding:5px;">UOM</th>
                        <th style="width:18%; border-left:1px solid black; padding:5px;">Amount</th>
                    </tr>

                    <t t-set="sl" t-value="1"/>
                    <t t-set="total" t-value="0"/>

                    
                    <t t-if="so">
                        <t t-foreach="so.order_line" t-as="line">

                            <t t-if="not line.display_type and line.product_id.type != 'service'">

                                <tr>
                                    <td style="border-right:1px solid black; padding:5px;">
                                        <t t-esc="sl"/>
                                    </td>

                                    
                                    <td style="border-right:1px solid black; padding:5px; vertical-align:top;">

                                        <b t-esc="line.product_id.display_name"/>

                                        
                                        <t t-set="moves"
                                           t-value="o.move_ids_without_package.filtered(lambda m: m.sale_line_id.id == line.id)"/>

                                        <t t-set="lots"
                                           t-value="moves.mapped('move_line_ids').mapped('lot_id')"/>

                                        <t t-if="lots">
                                            <div style="margin-top:3px;">
                                                <b>Batch :</b>
                                                <span t-esc="', '.join(lots.mapped('name'))"/>
                                            </div>
                                        </t>

                                        
                                        <t t-if="line.product_packaging_id">
                                            <div>
                                                Packing :
                                                <span t-field="line.product_packaging_id"/>
                                            </div>
                                        </t>

                                    </td>
                                    
                                    <td style="border-right:1px solid black; padding:5px;">
                                        <t t-esc="line.product_id.l10n_in_hsn_code or ''"/>
                                    </td>

                                    
                                    <td style="border-right:1px solid black; padding:5px; text-align:right;">

                                        <t t-set="moves"
                                           t-value="o.move_ids_without_package.filtered(lambda m: m.sale_line_id.id == line.id)"/>

                                        <t t-set="qty"
                                           t-value="
                                                   sum(moves.mapped('move_line_ids.qty_done'))
                                                   if sum(moves.mapped('move_line_ids.qty_done')) > 0
                                                   else sum(moves.mapped('quantity'))
                                               "/>

                                        <t t-esc="qty"/>
                                        <t t-esc="line.product_uom.name"/>
                                    </td>

                                    
                                    <td style="border-right:1px solid black; padding:5px; text-align:right;">
                                        <t t-esc="line.price_unit"/>
                                    </td>

                                    
                                    <td style="border-right:1px solid black; padding:5px; text-align:right;">
                                        <t t-esc="line.product_uom.name"/>
                                    </td>

                                    
                                    <td style="text-align:right; padding:5px;">
                                        <t t-set="line_amt" t-value="qty * line.price_unit"/>
                                        <t t-esc="line_amt"/>
                                    </td>
                                </tr>

                                <t t-set="total" t-value="total + (qty * line.price_unit)"/>
                                <t t-set="sl" t-value="sl + 1"/>

                            </t>
                        </t>
                    </t>

                    
                    <t t-if="so">
                        <t t-foreach="so.order_line.filtered(lambda l: l.product_id.type=='service')" t-as="sline">
                            <tr>
                                <td style="border-right:1px solid black;"></td>
                                <td style="border-right:1px solid black; padding:5px;">
                                    <i t-esc="sline.name"/>
                                </td>
                                <td style="border-right:1px solid black;"></td>
                                <td style="border-right:1px solid black;"></td>
                                <td style="border-right:1px solid black;"></td>
                                <td style="border-right:1px solid black;"></td>
                                <td style="text-align:right; padding:5px;">
                                    <t t-esc="sline.price_subtotal"/>
                                </td>
                            </tr>

                            <t t-set="total" t-value="total + sline.price_subtotal"/>
                        </t>
                    </t>

                    
                    <t t-if="so">
                        <t t-set="tax_total" t-value="0"/>

                        <t t-foreach="so.order_line.filtered(lambda l: not l.display_type and l.product_id.type!='service')"
                           t-as="l">

                            
                            <t t-set="line_tax" t-value="0"/>
                            <t t-foreach="l.tax_id" t-as="tx">
                                <t t-set="line_tax" t-value="line_tax + (l.price_subtotal * tx.amount / 100)"/>
                            </t>

                            
                            <t t-if="line_tax">
                                <tr>
                                    
                                    <td style="border-right:1px solid black; border-bottom:1px solid black;"></td>

                                    
                                    <td style="border-right:1px solid black; border-bottom:1px solid black; padding:5px 8px;">
                                        <t t-esc="', '.join(l.tax_id.mapped('name'))"/>
                                    </td>

                                    
                                    <td style="border-right:1px solid black; border-bottom:1px solid black;"></td>

                                    
                                    <td style="border-right:1px solid black; border-bottom:1px solid black;"></td>

                                    
                                    <td style="border-right:1px solid black; border-bottom:1px solid black; text-align:right; padding:5px;">
                                        <t t-esc="l.tax_id[0].amount if l.tax_id else 0"/>%
                                    </td>

                                    
                                    <td style="border-right:1px solid black; border-bottom:1px solid black;"></td>

                                    
                                    <td style="border-bottom:1px solid black; text-align:right; padding:5px;">
                                        <t t-esc="line_tax"/>
                                    </td>
                                </tr>
                            </t>

                            <t t-set="tax_total" t-value="tax_total + line_tax"/>

                        </t>

                        
                        <t t-set="total" t-value="total + tax_total"/>
                    </t>

                    
                    <tr style="border-top:1px solid black; font-weight:bold;">
                        <td></td>

                        <td style="border-right:1px solid black; text-align:right; padding-right:8px;">
                            Total
                        </td>

                        <td style="border-right:1px solid black;"></td>
                        <td style="border-right:1px solid black;"></td>
                        <td style="border-right:1px solid black;"></td>
                        <td style="border-right:1px solid black;"></td>

                        <td style="text-align:right; padding:5px;">
                            ₹
                            <t t-esc="total"/>
                        </td>
                    </tr>
                </table>
                <div style="width: 100%; clear: both; padding: 0;">
                    <table class="table table-sm w-100"
                           style="table-layout: fixed; border-collapse: collapse; border: 1px solid black; margin-bottom: 0;">
                        <tr>
                            <td class="p-2" style="width: 100%; vertical-align: top; padding:6px 8px;">

                                
                                <div style="width:100%; overflow:hidden;">
                                    <div style="float:left;">
                                        Amount Chargeable (in words)
                                    </div>

                                    <div style="float:right;">
                                        E. &amp; O.E
                                    </div>
                                </div>

                                
                                <div style="clear:both; font-size:12px; margin-top:2px;">
                                    <strong>Indian Rupees</strong>
                                    <strong>
                                        <t t-esc="currency.amount_to_text(total)"/>
                                    </strong>
                                    <strong>Only</strong>
                                </div>

                            </td>
                        </tr>
                    </table>
                </div>

                
                <t t-if="so">

                    <t t-set="hsn_map" t-value="{}"/>

                    
                    <t t-foreach="so.order_line.filtered(lambda l: not l.display_type)" t-as="l">

                        <t t-set="hsn" t-value="l.product_id.l10n_in_hsn_code or '000000'"/>
                        <t t-set="taxable" t-value="l.price_subtotal"/>

                        
                        <t t-set="tax_amt" t-value="0"/>
                        <t t-foreach="l.tax_id" t-as="tx">
                            <t t-set="tax_amt" t-value="tax_amt + (taxable * tx.amount / 100)"/>
                        </t>

                        
                        <t t-if="hsn in hsn_map">
                            <t t-set="old" t-value="hsn_map[hsn]"/>
                            <t t-set="hsn_map"
                               t-value="dict(hsn_map, **{
                   hsn: {
                       'taxable': old['taxable'] + taxable,
                       'tax': old['tax'] + tax_amt,
                       'rate': old['rate']
                   }
               })"/>
                        </t>

                        
                        <t t-if="hsn not in hsn_map">
                            <t t-set="hsn_map"
                               t-value="dict(hsn_map, **{
                   hsn: {
                       'taxable': taxable,
                       'tax': tax_amt,
                       'rate': (l.tax_id and l.tax_id[0].amount) or 0
                   }
               })"/>
                        </t>

                    </t>

                    
                    <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                        <tr style="background:#f0f0f0;">
                            <th style="padding:6px;">HSN/SAC</th>
                            <th style="padding:6px; text-align:right;">Taxable Value</th>
                            <th style="padding:6px; text-align:right;">Rate</th>
                            <th style="padding:6px; text-align:right;">Tax Amount</th>
                            <th style="padding:6px; text-align:right;">Total Tax</th>
                        </tr>

                        <t t-set="tot_taxable" t-value="0"/>
                        <t t-set="tot_tax" t-value="0"/>

                        <t t-foreach="hsn_map.items()" t-as="row">
                            <tr>
                                <td style="padding:6px;">
                                    <t t-esc="row[0]"/>
                                </td>

                                <td style="padding:6px; text-align:right;">
                                    <t t-esc="row[1]['taxable']"/>
                                </td>

                                <td style="padding:6px; text-align:right;">
                                    <t t-esc="row[1]['rate']"/>%
                                </td>

                                <td style="padding:6px; text-align:right;">
                                    <t t-esc="row[1]['tax']"/>
                                </td>

                                <td style="padding:6px; text-align:right;">
                                    <t t-esc="row[1]['tax']"/>
                                </td>
                            </tr>

                            <t t-set="tot_taxable" t-value="tot_taxable + row[1]['taxable']"/>
                            <t t-set="tot_tax" t-value="tot_tax + row[1]['tax']"/>
                        </t>

                        
                        <tr style="font-weight:bold; border-top:1px solid black;">
                            <td style="text-align:right; padding:6px;">Total</td>
                            <td style="padding:6px; text-align:right;">
                                <t t-esc="tot_taxable"/>
                            </td>
                            <td></td>
                            <td style="padding:6px; text-align:right;">
                                <t t-esc="tot_tax"/>
                            </td>
                            <td style="padding:6px; text-align:right;">
                                <t t-esc="tot_tax"/>
                            </td>
                        </tr>

                        
                        <tr>
                            <td colspan="5" style="padding:6px;">
                                Tax Amount (in words):
                                <strong>
                                    Indian Rupees
                                    <t t-esc="currency.amount_to_text(tot_tax)"/>
                                    Only
                                </strong>
                            </td>
                        </tr>
                    </table>

                </t>
                <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                    <tr>
                        <td style="width:60%; border-right:1px solid black; padding:8px; vertical-align:top;">
                            <div>
                                Company’s GST No. :
                                <b>
                                    <t t-esc="o.company_id.vat"/>
                                </b>
                            </div>

                            <div>
                                Company’s MSME No. :
                                <b>
                                    <t t-esc="o.company_id.msme_no"/>
                                </b>
                            </div>

                            <div>
                                Company’s PAN :
                                <b>
                                    <t t-esc="o.company_id.partner_id.l10n_in_pan"/>
                                </b>
                            </div>

                            <div style="margin-top:12px;">
                                Recd. in Good Condition
                            </div>
                        </td>

                        <td style="width:40%; padding:8px; text-align:right; vertical-align:top;">
                            <div style="font-weight:bold;">
                                for
                                <t t-esc="o.company_id.name"/>
                            </div>

                            <div style="height:70px;"></div>

                            <div>Authorised Signatory</div>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="2" style="text-align:center; padding:6px;">
                            This is a Computer Generated Document
                        </td>
                    </tr>
                </table>

            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_production_request" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.production.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="rsd_sales.view_sale_order_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button class="oe_stat_button"
                        name="action_view_production_requests"
                        type="object"
                        icon="fa-cubes"
                        invisible="production_request_count == 0">
                    <field name="production_request_count" widget="statinfo" string="Production Requests"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='fg_fulfilment']" position="inside">
                <group string="Production Requests">
                    <field name="production_request_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="name"/>
                            <field name="picking_id"/>
                            <field name="line_count"/>
                            <field name="material_ready_date"/>
                            <field name="mo_count"/>
                            <field name="pi_count"/>
                            <field name="state"/>
                            <field name="accepted_by"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

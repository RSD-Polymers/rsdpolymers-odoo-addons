<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Remove old planning list view if it exists -->
<!--    <delete id="view_production_request_list_plan" model="ir.ui.view"/>-->


    <!-- ========================================================= -->
    <!-- PRODUCT-WISE PRODUCTION REQUEST LIST                     -->
    <!-- ========================================================= -->

    <record id="view_production_request_list" model="ir.ui.view">
        <field name="name">production.request.line.list</field>
        <field name="model">production.request.line</field>
        <field name="arch" type="xml">
            <list create="0"
                  edit="0"
                  delete="0"
                  decoration-warning="state == 'requested'"
                  decoration-info="state == 'accepted'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">

                <field name="request_id" string="Request No."/>
                <field name="sale_id" string="Sales Order"/>
                <field name="picking_id" string="Delivery Order"/>
                <field name="product_id" string="Product"/>
                <field name="required_qty" string="Required Qty"/>
                <field name="product_packaging_qty" string="Packaging Qty"/>
                <field name="product_packaging_id" string="Packaging"/>
                <field name="material_ready_date" string="Material Ready Date"/>
                <field name="state" string="Status"/>

            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST FORM                                   -->
    <!-- ========================================================= -->

    <record id="view_production_request_form" model="ir.ui.view">
        <field name="name">production.request.form</field>
        <field name="model">production.request</field>
        <field name="arch" type="xml">
            <form>

                <header>

                    <button name="action_accept"
                            type="object"
                            string="Accept Request"
                            class="oe_highlight"
                            groups="mrp.group_mrp_user,mrp.group_mrp_manager"
                            invisible="state != 'requested'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('done','cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="requested,accepted,in_production,done"/>

                </header>


                <sheet>

                    <!-- ================================================= -->
                    <!-- STAT BUTTONS                                      -->
                    <!-- ================================================= -->

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_mos"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-industry"
                                invisible="mo_count == 0">

                            <field name="mo_count"
                                   widget="statinfo"
                                   string="Manufacturing Orders"/>

                        </button>


                        <button name="action_view_pis"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                invisible="pi_count == 0">

                            <field name="pi_count"
                                   widget="statinfo"
                                   string="Packing Instructions"/>

                        </button>

                    </div>


                    <!-- ================================================= -->
                    <!-- PRODUCTION REQUEST HEADER INFORMATION             -->
                    <!-- ================================================= -->

                    <group>

                        <group>

                            <field name="name"
                                   readonly="1"/>

                            <field name="sale_id"
                                   readonly="1"/>

                            <field name="picking_id"
                                   readonly="1"/>

                        </group>


                        <group>

                            <field name="material_ready_date"
                                   readonly="1"/>

                            <field name="requested_by"
                                   readonly="1"/>

                            <field name="accepted_by"
                                   readonly="1"/>

                            <field name="accepted_date"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- PRODUCTION LINES                                  -->
                    <!-- ================================================= -->

                    <notebook>

                        <page string="Production Lines"
                              name="production_lines">

                            <field name="line_ids"
                                   nolabel="1">

                                <list create="0"
                                      delete="0"
                                      edit="0">

                                    <field name="product_id"/>

                                    <field name="product_uom_id"
                                           string="UoM"/>

                                    <field name="required_qty"/>

                                    <field name="product_packaging_qty"
                                           string="Packaging Qty"/>

                                    <field name="product_packaging_id"
                                           string="Packaging"/>

                                    <field name="fg_available_qty"/>

                                    <field name="shortage_qty"/>

                                    <!--
                                    Create MO and Create PI buttons
                                    intentionally removed.
                                    -->

                                </list>

                            </field>

                        </page>

                    </notebook>


                    <!-- ================================================= -->
                    <!-- COMPANY                                            -->
                    <!-- ================================================= -->

                    <group>

                        <field name="company_id"
                               readonly="1"/>

                    </group>

                </sheet>


                <chatter/>

            </form>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- ACCEPT PRODUCTION REQUEST WIZARD                          -->
    <!-- ========================================================= -->

    <record id="view_production_request_accept_wizard" model="ir.ui.view">

        <field name="name">
            production.request.accept.wizard.form
        </field>

        <field name="model">
            production.request.accept.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Accept Production Request">

                <group>

                    <field name="request_id"/>

                    <field name="material_ready_date"/>

                </group>


                <footer>

                    <button name="action_accept"
                            type="object"
                            string="Accept"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST EXECUTION WIZARD                       -->
    <!-- ========================================================= -->

    <record id="view_production_request_execution_wizard"
            model="ir.ui.view">

        <field name="name">
            production.request.execution.wizard.form
        </field>

        <field name="model">
            production.request.execution.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Create Production Document">

                <group>

                    <field name="request_line_id"/>

                    <field name="execution_type"/>

                    <field name="quantity"/>

                </group>


                <footer>

                    <button name="action_create"
                            type="object"
                            string="Create"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST MENU ACTION                            -->
    <!-- ========================================================= -->

    <record id="action_production_request"
            model="ir.actions.act_window">

        <field name="name">
            Production Requests
        </field>

        <field name="res_model">
            production.request.line
        </field>

        <field name="view_mode">
            list
        </field>

        <field name="view_id"
               ref="view_production_request_list"/>

    </record>


    <!-- ========================================================= -->
    <!-- MENU                                                       -->
    <!-- ========================================================= -->

    <menuitem id="menu_production_request"
              name="Production Requests"
              parent="mrp.menu_mrp_manufacturing"
              action="action_production_request"
              groups="mrp.group_mrp_user,mrp.group_mrp_manager"
              sequence="1"/>

</odoo>
<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST LINE - PRODUCT WISE LIST -->
    <!-- ========================================================= -->

    <record id="view_production_request_list" model="ir.ui.view">
        <field name="name">production.request.line.list</field>
        <field name="model">production.request.line</field>
        <field name="arch" type="xml">
            <list string="Production Requests">

                <field name="request_id" string="Request No."/>
                <field name="sale_id" string="Sales Order"/>
                <field name="picking_id" string="Delivery Order"/>
                <field name="product_id" string="Product"/>
                <field name="required_qty" string="Required Qty"/>
                <field name="product_packaging_qty" string="Packaging Qty"/>
                <field name="product_packaging_id" string="Packaging"/>
                <field name="material_ready_date" string="Material Ready Date"/>
                <field name="state" string="Status"/>

            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST FORM -->
    <!-- ========================================================= -->

    <record id="view_production_request_form" model="ir.ui.view">
        <field name="name">production.request.form</field>
        <field name="model">production.request</field>
        <field name="arch" type="xml">

            <form string="Production Request">

                <header>

                    <!-- Accept -->
                    <button name="action_accept"
                            string="Accept"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'requested'"/>

                    <!-- Reject -->
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'requested'"/>

                    <!-- Execution -->
                    <button name="action_execution"
                            string="Execution"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'accepted'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="requested,accepted,rejected,execution"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="sale_id"/>
                            <field name="picking_id"/>
                            <field name="material_ready_date"/>
                        </group>

                        <group>
                            <field name="requested_by"/>
                            <field name="accepted_by"/>
                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- PRODUCTION LINES -->
                    <!-- ================================================= -->

                    <notebook>

                        <page string="Production Lines">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="product_id"/>

                                    <field name="product_uom_id"
                                           string="UoM"/>

                                    <field name="required_qty"
                                           string="Required Qty"/>

                                    <field name="product_packaging_qty"
                                           string="Packaging Qty"/>

                                    <field name="product_packaging_id"
                                           string="Packaging"/>

                                    <field name="fg_available_qty"
                                           string="FG Available Qty"/>

                                    <field name="shortage_qty"
                                           string="Shortage Qty"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- ACCEPT PRODUCTION REQUEST WIZARD -->
    <!-- ========================================================= -->

    <record id="view_production_request_accept_wizard" model="ir.ui.view">

        <field name="name">production.request.accept.wizard.form</field>

        <!-- IMPORTANT:
             Keep this on ONE LINE.
             The previous multiline value was being passed to Odoo
             with whitespace and caused:
             Model not found: production.request.accept.wizard
        -->
        <field name="model">production.request.accept.wizard</field>

        <field name="arch" type="xml">

            <form string="Accept Production Request">

                <group>

                    <field name="production_request_id"
                           invisible="1"/>

                    <field name="material_ready_date"/>

                </group>

                <footer>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- EXECUTION WIZARD -->
    <!-- ========================================================= -->

    <record id="view_production_request_execution_wizard"
            model="ir.ui.view">

        <field name="name">production.request.execution.wizard.form</field>

        <!-- IMPORTANT:
             Keep this on ONE LINE.
        -->
        <field name="model">production.request.execution.wizard</field>

        <field name="arch" type="xml">

            <form string="Production Request Execution">

                <group>

                    <field name="production_request_id"
                           invisible="1"/>

                    <field name="line_id"/>

                    <field name="execution_qty"/>

                </group>

                <footer>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST ACTION -->
    <!-- ========================================================= -->

    <record id="action_production_request"
            model="ir.actions.act_window">

        <field name="name">Production Requests</field>

        <!-- IMPORTANT:
             Main menu opens production.request.line,
             therefore the list is product-wise.
        -->
        <field name="res_model">production.request.line</field>

        <field name="view_mode">list</field>

        <field name="view_id"
               ref="view_production_request_list"/>

    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST MENU -->
    <!-- ========================================================= -->

    <menuitem id="menu_production_request"
              name="Production Requests"
              parent="menu_production_root"
              action="action_production_request"
              sequence="10"/>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_request_list" model="ir.ui.view">
        <field name="name">production.request.list</field>
        <field name="model">production.request</field>
        <field name="arch" type="xml">
            <list multi="1"
                  decoration-warning="state == 'requested'"
                  decoration-info="state == 'accepted'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="sale_id"/>
                <field name="product_id"/>
                <field name="required_qty"/>
                <field name="fg_available_qty"/>
                <field name="shortage_qty"/>
                <field name="material_ready_date"/>
                <field name="planned_qty"/>
                <field name="mo_id"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="accepted_by"/>
            </list>
        </field>
    </record>

    <record id="view_production_request_form" model="ir.ui.view">
        <field name="name">production.request.form</field>
        <field name="model">production.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept"
                            type="object"
                            string="Accept Request"
                            class="oe_highlight"
                            groups="mrp.group_mrp_user,mrp.group_mrp_manager"
                            invisible="state != 'requested'"/>
                    <button name="action_plan_selected"
                            type="object"
                            string="Plan Production"
                            class="oe_highlight"
                            groups="mrp.group_mrp_user,mrp.group_mrp_manager"
                            invisible="state != 'accepted'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,accepted,planned,in_production,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="sale_line_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="required_qty" readonly="1"/>
                            <field name="fg_available_qty" readonly="1"/>
                            <field name="shortage_qty" readonly="1"/>
                            <field name="planned_qty" readonly="state not in ('accepted','planned')"/>
                            <field name="material_ready_date" readonly="1"/>
                            <field name="mo_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Production Confirmation">
                        <field name="accepted_by" readonly="1"/>
                        <field name="accepted_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="requested_by" readonly="1"/>
                        <field name="planned_by" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <span>Sales Order</span>
                        </button>
                        <button name="action_open_mo" type="object" class="oe_stat_button" icon="fa-industry" invisible="not mo_id">
                            <span>Manufacturing Order</span>
                        </button>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_production_request_accept_wizard" model="ir.ui.view">
        <field name="name">production.request.accept.wizard.form</field>
        <field name="model">production.request.accept.wizard</field>
        <field name="arch" type="xml">
            <form string="Accept Production Request">
                <group>
                    <field name="request_id"/>
                    <field name="material_ready_date"/>
                </group>
                <footer>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_production_request_plan_wizard" model="ir.ui.view">
        <field name="name">production.request.plan.wizard.form</field>
        <field name="model">production.request.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Production Planning">
                <sheet>
                    <group>
                        <field name="request_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="shortage_qty"/>
                            <field name="planned_qty"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_mo" type="object" string="Create Manufacturing Order(s)" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_production_request" model="ir.actions.act_window">
        <field name="name">Production Requests</field>
        <field name="res_model">production.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_production_request_list"/>
    </record>

    <menuitem id="menu_production_request"
              name="Production Requests"
              parent="mrp.menu_mrp_manufacturing"
              action="action_production_request"
              groups="mrp.group_mrp_user,mrp.group_mrp_manager"
              sequence="1"/>
</odoo>

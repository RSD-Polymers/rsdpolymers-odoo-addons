<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST LINE - PRODUCT WISE LIST -->
    <!-- ========================================================= -->

    <record id="view_production_request_list" model="ir.ui.view">
        <field name="name">production.request.line.list</field>
        <field name="model">production.request.line</field>

        <field name="arch" type="xml">
            <list string="Production Requests" create="0">

                <field name="request_id"
                       string="Request No."/>
                <button name="action_open_production_request"
                        type="object"
                        string="View"
                        class="btn-link"/>

                <field name="sale_id"
                       string="Sales Order"/>

                <field name="picking_id"
                       string="Delivery Order"/>

                <field name="product_id"
                       string="Product"/>

                <field name="required_qty"
                       string="Required Qty"
                       readonly="state != 'requested'"/>

                <field name="product_packaging_qty"
                       string="Packaging Qty"/>

                <field name="product_packaging_id"
                       string="Packaging"/>

                <field name="material_ready_date"
                       string="Material Ready Date"/>

                <field name="state"
                       string="Status"/>

            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST FORM -->
    <!-- ========================================================= -->

    <record id="view_production_request_form"
            model="ir.ui.view">

        <field name="name">production.request.form</field>
        <field name="model">production.request</field>

        <field name="arch" type="xml">

            <form string="Production Request">

                <header>

                    <!-- ACCEPT -->
                    <button name="action_accept"
                            string="Accept"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'requested'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('done', 'cancelled', 'production_done')"/>
                    <button name="action_mark_production_done"
                            string="Mark Production Done"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('accepted', 'in_production')"/>
                    <button name="action_acknowledge_store"
                            string="Acknowledge (Store)"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'production_done' or store_acknowledged"/>
                    <button name="action_acknowledge_sales"
                            string="Acknowledge (Sales)"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'production_done' or sales_acknowledged"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="requested,accepted,in_production,production_done,done,cancelled"/>

                </header>


                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>


                    <group>

                        <group>
                            <field name="sale_id"/>
                            <field name="picking_id"/>
                            <field name="material_ready_date"/>
                        </group>

                        <group>
                            <field name="requested_by"/>
                            <field name="accepted_by"/>
                            <field name="accepted_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                            <field name="rejected_by" invisible="not rejected_by"/>
                            <field name="rejected_date" invisible="not rejected_date"/>
                            <field name="production_done_by" invisible="not production_done_by"/>
                            <field name="production_done_date" invisible="not production_done_date"/>
                            <field name="store_acknowledged"/>
                            <field name="store_acknowledged_by" invisible="not store_acknowledged_by"/>
                            <field name="store_acknowledged_date" invisible="not store_acknowledged_date"/>
                            <field name="sales_acknowledged"/>
                            <field name="sales_acknowledged_by" invisible="not sales_acknowledged_by"/>
                            <field name="sales_acknowledged_date" invisible="not sales_acknowledged_date"/>
                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- PRODUCTION LINES -->
                    <!-- ================================================= -->

                    <notebook>

                        <page string="Production Lines">

                            <field name="line_ids">

                                <list>

                                    <field name="product_id"
                                           string="Product"/>

                                    <field name="product_uom_id"
                                           string="UoM"/>

                                    <field name="required_qty"
                                           string="Required Qty"
                                           readonly="state != 'requested'"/>

                                    <field name="product_packaging_qty"
                                           string="Packaging Qty"/>

                                    <field name="product_packaging_id"
                                           string="Packaging"/>

                                    <field name="fg_available_qty"
                                           string="FG Available Qty"/>

                                    <field name="shortage_qty"
                                           string="Shortage Qty"/>

                                    <field name="mo_qty"
                                           string="MO Qty"/>

                                    <field name="pi_qty"
                                           string="PI Qty"/>

                                    <field name="allocated_qty"
                                           string="Allocated Qty"/>

                                    <field name="remaining_qty"
                                           string="Remaining Qty"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- ACCEPT PRODUCTION REQUEST WIZARD -->
    <!-- ========================================================= -->

    <record id="view_production_request_accept_wizard"
            model="ir.ui.view">

        <field name="name">
            production.request.accept.wizard.form
        </field>

        <field name="model">production.request.accept.wizard</field>

        <field name="arch" type="xml">

            <form string="Accept Production Request">

                <group>

                    <field name="request_id"
                           invisible="1"/>

                    <field name="material_ready_date"/>

                </group>

                <footer>

                    <button name="action_accept"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- EXECUTION WIZARD -->
    <!-- ========================================================= -->

    <record id="view_production_request_execution_wizard"
            model="ir.ui.view">

        <field name="name">
            production.request.execution.wizard.form
        </field>

        <field name="model">production.request.execution.wizard</field>

        <field name="arch" type="xml">

            <form string="Production Request Execution">

                <group>

                    <field name="request_line_id"
                           invisible="1"/>

                    <field name="execution_type"/>

                    <field name="quantity"/>

                </group>

                <footer>

                    <button name="action_create"
                            string="Create"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST ACTION -->
    <!-- ========================================================= -->

    <record id="action_production_request"
            model="ir.actions.act_window">

        <field name="name">Production Requests</field>

        <!-- PRODUCT-WISE LIST -->
        <field name="res_model">production.request.line</field>

        <field name="view_mode">list</field>

        <field name="view_id"
               ref="view_production_request_list"/>

    </record>


    <!-- ========================================================= -->
    <!-- PRODUCTION REQUEST MENU -->
    <!-- ========================================================= -->

    <menuitem id="menu_production_request"
              name="Production Requests"
              parent="mrp.menu_mrp_manufacturing"
              action="action_production_request"
              sequence="0"/>

    <!-- Same Production Request action for Store users in Inventory -->
    <menuitem id="menu_production_request_inventory"
              name="Production Requests"
              parent="stock.menu_stock_root"
              action="action_production_request"
              groups="stock.group_stock_user,stock.group_stock_manager"
              sequence="55"/>

</odoo>
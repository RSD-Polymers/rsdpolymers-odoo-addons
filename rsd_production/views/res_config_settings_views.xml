<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_production_request" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.production.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Production Requests" name="rsd_production_request_settings">
                    <setting id="allow_production_request_mo_pi"
                             string="Allow MO/PI Creation from Production Requests"
                             help="Enable this option to allow authorized Production users to create Manufacturing Orders and Packing Instructions directly from Production Request lines.">
                        <field name="allow_production_request_mo_pi"/>
                    </setting>
                </block>
                <block title="Output Form Controls" name="rsd_output_form_settings">
                    <setting id="enable_rm_consumption_variance_tracking"
                             string="Enable Raw Material Consumption Variance Tracking"
                             help="Compare planned BoM consumption with actual raw material consumption on the Output Form.">
                        <field name="enable_rm_consumption_variance_tracking"/>
                    </setting>
                    <setting id="require_rm_consumption_variance_reason"
                             string="Require Reason for Additional Consumption"
                             help="Require an explanation when actual raw material consumption exceeds planned consumption."
                             invisible="not enable_rm_consumption_variance_tracking">
                        <field name="require_rm_consumption_variance_reason"/>
                    </setting>
                    <setting id="allow_rm_consumption_variance_reason_breakdown"
                             string="Allow Quantity-wise Reason Breakdown"
                             help="Allow additional consumption to be recorded as separate reason and quantity lines."
                             invisible="not enable_rm_consumption_variance_tracking">
                        <field name="allow_rm_consumption_variance_reason_breakdown"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

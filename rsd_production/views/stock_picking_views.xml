<odoo>
    <record id="view_picking_form_production_request" model="ir.ui.view">
        <field name="name">stock.picking.form.production.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_production_requests"
                        type="object"
                        string="Create Production Request"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="picking_type_code != 'outgoing' or state in ('done','cancel') or not is_store_user"/>
            </xpath>
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_production_requests"
                        icon="fa-cubes"
                        invisible="production_request_count == 0">
                    <field name="production_request_count"
                           widget="statinfo"
                           string="Production Requests"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Production Requests" name="production_requests_tab"
                      invisible="production_request_count == 0">
                    <field name="production_request_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0">
                            <field name="name" string="Request No."/>
                            <field name="sale_id" string="Sales Order"/>
                            <field name="state" string="Status"/>
                            <field name="store_acknowledged" string="Store Acknowledged"/>
                            <field name="store_acknowledged_by" string="Acknowledged By"/>
                            <field name="store_acknowledged_date" string="Acknowledged On"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_picking_form_production_request" model="ir.ui.view">
        <field name="name">stock.picking.form.production.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_production_requests"
                        type="object"
                        string="Create Production Request"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="picking_type_code != 'outgoing' or state in ('done','cancel') or not is_store_user or not has_production_shortage"/>
            </xpath>
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_production_requests"
                        icon="fa-cubes"
                        invisible="production_request_count == 0">
                    <field name="production_request_count"
                           widget="statinfo"
                           string="Production Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_request_reject_wizard" model="ir.ui.view">
        <field name="name">production.request.reject.wizard.form</field>
        <field name="model">production.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Production Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Enter the reason for rejecting this request..." required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

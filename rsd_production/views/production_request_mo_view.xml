<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_production_request_button" model="ir.ui.view">
        <field name="name">mrp.production.production.request.button</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_production_requests" icon="fa-cubes" invisible="production_request_count == 0">
                    <field name="production_request_count" widget="statinfo" string="Production Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <record id="action_rm_return" model="ir.actions.act_window">
        <field name="name">RM Returns</field>
        <field name="res_model">rm.return</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_rm_return_list" model="ir.ui.view">
        <field name="name">rm.return.list</field>
        <field name="model">rm.return</field>
        <field name="arch" type="xml">
            <list string="RM Returns">
                <field name="name"/><field name="mo_id"/><field name="original_rm_issue_id"/><field name="picking_id"/><field name="requested_by"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_rm_return_form" model="ir.ui.view">
        <field name="name">rm.return.form</field>
        <field name="model">rm.return</field>
        <field name="arch" type="xml">
            <form string="RM Return">
                <header>
                    <button name="action_submit" string="Submit Return to Store" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_received" string="Confirm Received" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('received','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,received,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="mo_id" readonly="state != 'draft'"/><field name="company_id" readonly="1"/><field name="original_rm_issue_id" readonly="state != 'draft'" options="{'no_create': True}"/></group>
                        <group><field name="source_location_id" readonly="1"/><field name="destination_location_id" readonly="1"/><field name="picking_id" readonly="1"/><field name="requested_by" readonly="1"/><field name="received_by" readonly="1"/></group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom"><field name="product_id" readonly="1"/><field name="qty"/><field name="uom_id" readonly="1"/></list>
                    </field>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Inventory entry point for Store users -->
    <menuitem id="menu_rm_return_inventory" name="RM Returns" parent="stock.menu_stock_transfers" action="action_rm_return" groups="stock.group_stock_user,stock.group_stock_manager" sequence="51"/>

    <!-- Manufacturing entry point for Production users -->
    <menuitem id="menu_rm_return_manufacturing" name="RM Return Requests" parent="mrp.menu_mrp_manufacturing" action="action_rm_return" groups="mrp.group_mrp_user" sequence="66"/>
</odoo>

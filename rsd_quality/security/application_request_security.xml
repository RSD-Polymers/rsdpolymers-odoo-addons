<odoo>
  <record id="rule_application_request_owner" model="ir.rule">
    <field name="name">Application Requests: requester own</field>
    <field name="model_id" ref="model_rsd_quality_application_request"/>
    <field name="domain_force">[('requester_id','=',user.id)]</field>
    <field name="groups" eval="[(4,ref('rnd_workflow.group_rnd_sm'))]"/>
  </record>
  <record id="rule_application_request_assigned" model="ir.rule">
    <field name="name">Application Requests: assigned tester</field>
    <field name="model_id" ref="model_rsd_quality_application_request"/>
    <field name="domain_force">[('assigned_user_id','=',user.id)]</field>
    <field name="groups" eval="[(4,ref('group_application_test_user'))]"/>
  </record>
  <record id="rule_application_request_manager" model="ir.rule">
    <field name="name">Application Requests: manager access</field>
    <field name="model_id" ref="model_rsd_quality_application_request"/>
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="groups" eval="[(4,ref('rnd_workflow.group_rnd_owner'))]"/>
  </record>
  <record id="rule_application_attempt_requester" model="ir.rule">
    <field name="name">Application Attempts: requester access</field>
    <field name="model_id" ref="model_rsd_quality_application_attempt"/>
    <field name="domain_force">[('request_id.requester_id','=',user.id)]</field>
    <field name="groups" eval="[(4,ref('rnd_workflow.group_rnd_sm'))]"/>
  </record>
  <record id="rule_application_attempt_assigned" model="ir.rule">
    <field name="name">Application Attempts: assigned tester</field>
    <field name="model_id" ref="model_rsd_quality_application_attempt"/>
    <field name="domain_force">[('assigned_user_id','=',user.id)]</field>
    <field name="groups" eval="[(4,ref('group_application_test_user'))]"/>
  </record>
  <record id="rule_application_attempt_manager" model="ir.rule">
    <field name="name">Application Attempts: manager access</field>
    <field name="model_id" ref="model_rsd_quality_application_attempt"/>
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="groups" eval="[(4,ref('rnd_workflow.group_rnd_owner'))]"/>
  </record>
</odoo>
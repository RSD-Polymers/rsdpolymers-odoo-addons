<odoo>
 <record id="group_application_request_reviewer" model="res.groups"><field name="name">Senior Application User - Request Review</field><field name="category_id" ref="base.module_category_manufacturing"/></record>
 <record id="group_application_experiment_user" model="res.groups"><field name="name">Application User - Experiment</field><field name="category_id" ref="base.module_category_manufacturing"/><field name="implied_ids" eval="[(4,ref('group_application_test_user'))]"/></record>
 <record id="group_application_experiment_reviewer" model="res.groups"><field name="name">Senior Application User - Experiment Review</field><field name="category_id" ref="base.module_category_manufacturing"/></record>
 <record id="rule_application_requester" model="ir.rule"><field name="name">Application Requests - Requester</field><field name="model_id" ref="model_rsd_quality_application_request"/><field name="domain_force">[('requester_id','=',user.id)]</field><field name="groups" eval="[(4,ref('rnd_workflow.group_rnd_sm'))]"/></record>
 <record id="rule_application_request_company" model="ir.rule"><field name="name">Application Requests - Company Review Roles</field><field name="model_id" ref="model_rsd_quality_application_request"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('group_application_request_reviewer')),(4,ref('group_application_experiment_user')),(4,ref('group_application_experiment_reviewer')),(4,ref('rnd_workflow.group_rnd_owner')),(4,ref('base.group_system'))]"/></record>
 <record id="rule_application_experiment_company" model="ir.rule"><field name="name">Application Experiments - Company</field><field name="model_id" ref="model_rsd_quality_application_experiment"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('group_application_request_reviewer')),(4,ref('group_application_experiment_user')),(4,ref('group_application_experiment_reviewer')),(4,ref('rnd_workflow.group_rnd_sm')),(4,ref('rnd_workflow.group_rnd_owner')),(4,ref('base.group_system'))]"/></record>
 <record id="rule_application_experiment_interval_company" model="ir.rule"><field name="name">Experiment Intervals - Company</field><field name="model_id" ref="model_rsd_quality_application_experiment_interval"/><field name="domain_force">[('experiment_id.company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('group_application_experiment_user')),(4,ref('group_application_experiment_reviewer')),(4,ref('rnd_workflow.group_rnd_owner')),(4,ref('base.group_system'))]"/></record>
</odoo>

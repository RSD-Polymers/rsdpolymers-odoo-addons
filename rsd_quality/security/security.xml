<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated roles for the QC-owned unloading request workflow. -->
    <record id="group_unloading_request_supervisor" model="res.groups">
        <field name="name">Production Supervisor (Unloading Requests)</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>

    <record id="group_unloading_request_chemist" model="res.groups">
        <field name="name">Production Chemist (Unloading Requests)</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>

    <record id="rule_quality_unloading_request_company" model="ir.rule">
        <field name="name">Unloading Requests: allowed companies</field>
        <field name="model_id" ref="model_rsd_quality_unloading_request"/>
        <field name="groups" eval="[(4, ref('group_unloading_request_supervisor')), (4, ref('group_unloading_request_chemist')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_quality_test_user" model="res.groups">
        <field name="name">Quality Test User</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>

    <record id="rule_rsd_quality_sample_test_company" model="ir.rule">
        <field name="name">Sample Tests: allowed companies</field>
        <field name="model_id" ref="model_rsd_quality_sample_test"/>
        <field name="groups" eval="[(4, ref('group_quality_test_user')), (4, ref('rsd_qa_management.group_qa_officer')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rsd_quality_application_test_company" model="ir.rule">
        <field name="name">Application Tests: allowed companies</field>
        <field name="model_id" ref="model_rsd_quality_application_test"/>
        <field name="groups" eval="[(4, ref('group_quality_test_user')), (4, ref('rsd_qa_management.group_qa_officer')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rsd_quality_test_line_company" model="ir.rule">
        <field name="name">Quality Test Lines: allowed companies</field>
        <field name="model_id" ref="model_rsd_quality_test_line"/>
        <field name="groups" eval="[(4, ref('group_quality_test_user')), (4, ref('rsd_qa_management.group_qa_officer')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">['|', ('sample_test_id.company_id', 'in', company_ids), ('application_test_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>

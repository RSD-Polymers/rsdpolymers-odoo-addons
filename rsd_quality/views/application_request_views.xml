<odoo>
<record id="application_request_list" model="ir.ui.view"><field name="name">application.request.list</field><field name="model">rsd.quality.application.request</field><field name="arch" type="xml"><list><field name="name"/><field name="sample_name"/><field name="requester_id"/><field name="assigned_user_id"/><field name="request_date"/><field name="proposed_completion_date"/><field name="attempt_count"/><field name="state" widget="badge"/></list></field></record>
<record id="application_request_form" model="ir.ui.view"><field name="name">application.request.form</field><field name="model">rsd.quality.application.request</field><field name="arch" type="xml"><form><header>
<button name="action_submit_request" type="object" string="Submit Request" class="btn-primary" invisible="state not in ('draft','infeasible')" groups="rnd_workflow.group_rnd_sm,rnd_workflow.group_rnd_owner"/>
<button name="action_sample_received" type="object" string="Sample Received" invisible="state!='submitted'" groups="rsd_quality.group_application_test_user"/>
<button name="action_feasibility" type="object" string="Feasibility" invisible="state not in ('sample_received','feasibility_pending','date_revision')" groups="rsd_quality.group_application_test_user"/>
<button name="action_date_review" type="object" string="Review Expected Date" invisible="state!='date_acceptance'" groups="rnd_workflow.group_rnd_sm,rnd_workflow.group_rnd_owner"/>
<button name="action_submit_attempt" type="object" string="Submit Attempt" class="btn-primary" invisible="state!='testing'" groups="rsd_quality.group_application_test_user"/>
<button name="action_attempt_review" type="object" string="Review Attempt" class="btn-primary" invisible="state!='review'" groups="rnd_workflow.group_rnd_sm,rnd_workflow.group_rnd_owner"/>
<button name="action_cancel_request" type="object" string="Cancel" invisible="state not in ('draft','submitted','infeasible')" groups="rnd_workflow.group_rnd_sm,rnd_workflow.group_rnd_owner"/>
<field name="state" widget="statusbar" statusbar_visible="draft,submitted,sample_received,feasibility_pending,date_acceptance,date_revision,testing,review,completed"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="requester_id"/><field name="requester_employee_id"/><field name="department_id"/><field name="designation"/><field name="request_date"/><field name="assigned_user_id"/></group><group><field name="sample_name"/><field name="batch_no"/><field name="quantity"/><field name="quantity_uom"/><field name="manufacturer_name"/><field name="sender_name"/><field name="sent_by"/><field name="delivery_mode"/></group></group><group><field name="purpose"/><field name="compare_performance"/></group><group><field name="coa_attachment_ids" widget="many2many_binary"/></group><notebook>
<page string="Performance Parameters"><field name="parameter_ids" widget="many2many_tags"/><field name="has_other_parameter" invisible="1"/><field name="other_parameter" invisible="not has_other_parameter"/><field name="inhibition_test_ids" widget="many2many_tags"/><field name="inhibition_snapshot" readonly="1"/></page>
<page string="Sample &amp; Feasibility"><group><field name="sample_received_date"/><field name="feasibility"/><field name="feasibility_reason"/><field name="proposed_completion_date"/><field name="date_feedback"/><field name="date_proposal_history"/></group></page>
<page string="Attempts"><field name="attempt_ids" readonly="1"><list><field name="attempt_no"/><field name="start_date"/><field name="assigned_user_id"/><field name="submitted_on"/><field name="reviewed_on"/><field name="state" widget="badge"/></list></field><field name="current_attempt_id" readonly="1"/></page>
</notebook></sheet><chatter/></form></field></record>
<record id="application_request_action" model="ir.actions.act_window"><field name="name">R&amp;D Sample Requests</field><field name="res_model">rsd.quality.application.request</field><field name="view_mode">list,form</field></record>
<record id="application_attempt_form" model="ir.ui.view"><field name="name">application.attempt.form</field><field name="model">rsd.quality.application.attempt</field><field name="arch" type="xml"><form><sheet><group><field name="request_id"/><field name="attempt_no"/><field name="assigned_user_id"/><field name="state"/><field name="start_date"/><field name="submitted_on"/><field name="reviewed_on"/></group><field name="description"/><field name="attachment_ids" widget="many2many_binary"/><field name="requester_feedback"/></sheet><chatter/></form></field></record>
<!-- Modal wizard forms -->
<record id="sample_received_wizard_form" model="ir.ui.view"><field name="name">sample.received.wizard.form</field><field name="model">rsd.quality.application.sample.received.wizard</field><field name="arch" type="xml"><form><group><field name="request_id"/><field name="received_date"/></group><footer><button name="action_confirm" type="object" string="Confirm" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="feasibility_wizard_form" model="ir.ui.view"><field name="name">feasibility.wizard.form</field><field name="model">rsd.quality.application.feasibility.wizard</field><field name="arch" type="xml"><form><group><field name="request_id"/><field name="feasibility"/><field name="expected_date" invisible="feasibility!='yes'"/><field name="reason" invisible="feasibility!='no'"/></group><footer><button name="action_confirm" type="object" string="Confirm" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="date_review_wizard_form" model="ir.ui.view"><field name="name">date.review.wizard.form</field><field name="model">rsd.quality.application.date.review.wizard</field><field name="arch" type="xml"><form><group><field name="request_id"/><field name="decision"/><field name="feedback" invisible="decision!='reject'"/></group><footer><button name="action_confirm" type="object" string="Confirm" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="attempt_review_wizard_form" model="ir.ui.view"><field name="name">attempt.review.wizard.form</field><field name="model">rsd.quality.application.attempt.review.wizard</field><field name="arch" type="xml"><form><group><field name="request_id"/><field name="decision"/><field name="feedback" invisible="decision!='another'"/></group><footer><button name="action_confirm" type="object" string="Confirm" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_unloading_request" model="ir.ui.view">
        <field name="name">mrp.production.form.rsd.unloading.request</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_create_unloading_request"
                        type="object"
                        string="Request Unloading"
                        class="btn-primary"
                        groups="rsd_quality.group_unloading_request_supervisor"
                        invisible="state in ('draft', 'cancel', 'done')"/>
            </xpath>

        </field>
    </record>
</odoo>
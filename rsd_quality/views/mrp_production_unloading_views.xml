<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep the original external ID so the existing database view is updated. -->
    <record id="mrp_production_form_unloading_request" model="ir.ui.view">
        <field name="name">mrp.production.form.rsd.unloading.request</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="show_request_unloading_button" invisible="1"/>
                <field name="show_request_quality_button" invisible="1"/>
                <button name="action_request_quality" type="object" string="Request Quality"
                        class="btn-primary" groups="mrp.group_mrp_user"
                        invisible="not show_request_quality_button"/>
            </xpath>


        </field>
    </record>
</odoo>

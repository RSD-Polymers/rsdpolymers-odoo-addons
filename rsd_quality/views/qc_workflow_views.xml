<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="qc_spec_template_view_list" model="ir.ui.view"><field name="name">rsd.quality.spec.template.list</field><field name="model">rsd.quality.spec.template</field><field name="arch" type="xml"><list><field name="name"/><field name="product_id"/><field name="test_kind"/><field name="company_id"/><field name="active"/></list></field></record>
 <record id="qc_spec_template_view_form" model="ir.ui.view"><field name="name">rsd.quality.spec.template.form</field><field name="model">rsd.quality.spec.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="product_id"/><field name="test_kind"/><field name="company_id"/><field name="active"/></group><field name="line_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="value_type"/><field name="min_value"/><field name="max_value"/><field name="expected_text"/><field name="uom_id"/><field name="required"/></list></field></sheet><chatter/></form></field></record>
 <record id="qc_stage_test_view_list" model="ir.ui.view"><field name="name">rsd.quality.stage.test.list</field><field name="model">rsd.quality.stage.test</field><field name="arch" type="xml"><list><field name="name"/><field name="production_id"/><field name="product_id"/><field name="lot_id"/><field name="test_kind"/><field name="assigned_user_id"/><field name="expected_result_datetime"/><field name="state" widget="badge"/></list></field></record>
 <record id="qc_stage_test_view_form" model="ir.ui.view"><field name="name">rsd.quality.stage.test.form</field><field name="model">rsd.quality.stage.test</field><field name="arch" type="xml"><form><header><button name="action_acknowledge" type="object" string="Acknowledge Sample" invisible="test_kind != 'performance' or state != 'draft'"/><button name="action_start" type="object" string="Start Test" invisible="state not in ('draft','acknowledged')"/><button name="action_evaluate" type="object" string="Evaluate Results" class="btn-primary" invisible="state not in ('draft','acknowledged','in_progress')"/><button name="action_mark_not_required" type="object" string="Not Required" invisible="test_kind != 'performance' or state != 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,acknowledged,in_progress,passed,failed"/></header><sheet><group><field name="name"/><field name="production_id"/><field name="product_id"/><field name="lot_id"/><field name="test_kind"/><field name="template_id"/><field name="requested_by"/><field name="assigned_user_id"/><field name="expected_result_datetime" invisible="test_kind != 'performance'"/><field name="acknowledged_on"/><field name="result_date"/><field name="result_summary"/></group><field name="line_ids"><list editable="bottom"><field name="sequence"/><field name="template_line_id" domain="[('template_id','=',parent.template_id)]"/><field name="name"/><field name="result_value"/><field name="min_value"/><field name="max_value"/><field name="expected_text"/><field name="is_pass"/></list></field></sheet><chatter/></form></field></record>

 <record id="qc_unloading_analysis_view_form" model="ir.ui.view">
  <field name="name">rsd.quality.unloading.analysis.form</field><field name="model">rsd.quality.unloading.analysis</field>
  <field name="arch" type="xml"><form string="Unloading Analysis"><header>
   <button name="action_evaluate" type="object" string="Evaluate &amp; Submit" class="btn-primary" invisible="result != 'pending' or not can_edit_analysis"/>
   <field name="result" widget="statusbar" statusbar_visible="pending,pass,fail" readonly="not is_system_admin"/>
  </header><sheet><group><group><field name="name"/><field name="request_id"/><field name="cycle_no"/><field name="template_id"/></group><group><field name="analysed_by"/><field name="analysed_on"/><field name="evaluated_by"/><field name="evaluated_on"/></group></group>
   <field name="is_system_admin" invisible="1"/>
   <field name="can_edit_analysis" invisible="1"/>
   <field name="line_ids" readonly="(result != 'pending' or not can_edit_analysis) and not is_system_admin"><list editable="bottom"><field name="sequence"/><field name="template_line_id"/><field name="name"/><field name="value_type"/><field name="result_value"/><field name="min_value"/><field name="max_value"/><field name="expected_text"/><field name="uom_id"/><field name="is_pass"/></list></field>
   <group string="If Analysis Fails"><field name="modification_description" readonly="(result != 'pending' or not can_edit_analysis) and not is_system_admin" placeholder="Describe the physical modification required from Production..."/></group>
  </sheet><chatter/></form></field>
 </record>

 <record id="qc_spec_template_action" model="ir.actions.act_window"><field name="name">QC Specification Templates</field><field name="res_model">rsd.quality.spec.template</field><field name="view_mode">list,form</field></record>
 <record id="qc_stage_test_action" model="ir.actions.act_window"><field name="name">Performance &amp; Internal COA Tests</field><field name="res_model">rsd.quality.stage.test</field><field name="view_mode">list,form</field></record>
 <menuitem id="qc_workflow_root_menu" name="QC Workflow" parent="quality_control.menu_quality_control" sequence="45" groups="rsd_quality.group_quality_test_user,rsd_quality.group_unloading_request_chemist,base.group_system"/>
 <menuitem id="qc_spec_template_menu" name="Specification Templates" parent="qc_workflow_root_menu" action="qc_spec_template_action" sequence="10"/>
 <menuitem id="qc_stage_test_menu" name="Performance / Internal COA Tests" parent="qc_workflow_root_menu" action="qc_stage_test_action" sequence="20"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sample Test -->
    <record id="sample_test_view_list" model="ir.ui.view">
        <field name="name">rsd.quality.sample.test.list</field>
        <field name="model">rsd.quality.sample.test</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'passed'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="sample_reference"/>
                <field name="test_date"/>
                <field name="tested_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="sample_test_view_form" model="ir.ui.view">
        <field name="name">rsd.quality.sample.test.form</field>
        <field name="model">rsd.quality.sample.test</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit for Review" class="btn-primary" invisible="state not in ('draft','in_progress')"/>
                    <button name="action_pass" type="object" string="Pass" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <button name="action_fail" type="object" string="Fail" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <button name="action_create_deviation" type="object" string="Create QA Deviation" groups="rsd_qa_management.group_qa_officer" invisible="state != 'failed' or deviation_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','in_progress')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,submitted,passed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="lot_id" domain="[('product_id', '=', product_id)]"/>
                            <field name="sample_reference"/>
                        </group>
                        <group>
                            <field name="test_date"/>
                            <field name="tested_by"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_on"/>
                            <field name="deviation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Test Results">
                            <field name="sample_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter"/>
                                    <field name="specification"/>
                                    <field name="result_value"/>
                                    <field name="uom"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary"><field name="result_summary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="sample_test_action" model="ir.actions.act_window">
        <field name="name">Sample Tests</field>
        <field name="res_model">rsd.quality.sample.test</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sample_test_menu" name="Sample Tests" parent="quality_control.menu_quality_control" action="sample_test_action" sequence="50" groups="rsd_quality.group_quality_test_user,rsd_qa_management.group_qa_officer,base.group_system"/>

    <!-- Application Test -->
    <record id="application_test_view_list" model="ir.ui.view">
        <field name="name">rsd.quality.application.test.list</field>
        <field name="model">rsd.quality.application.test</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'passed'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="application_name"/>
                <field name="test_date"/>
                <field name="tested_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="application_test_view_form" model="ir.ui.view">
        <field name="name">rsd.quality.application.test.form</field>
        <field name="model">rsd.quality.application.test</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit for Review" class="btn-primary" invisible="state not in ('draft','in_progress')"/>
                    <button name="action_pass" type="object" string="Pass" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <button name="action_fail" type="object" string="Fail" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <button name="action_create_deviation" type="object" string="Create QA Deviation" groups="rsd_qa_management.group_qa_officer" invisible="state != 'failed' or deviation_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','in_progress')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,submitted,passed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="lot_id" domain="[('product_id', '=', product_id)]"/>
                            <field name="application_name"/>
                            <field name="test_method"/>
                        </group>
                        <group>
                            <field name="test_date"/>
                            <field name="tested_by"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_on"/>
                            <field name="deviation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Test Results">
                            <field name="application_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter"/>
                                    <field name="specification"/>
                                    <field name="result_value"/>
                                    <field name="uom"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary"><field name="result_summary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="application_test_action" model="ir.actions.act_window">
        <field name="name">Application Tests</field>
        <field name="res_model">rsd.quality.application.test</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="application_test_menu" name="Application Tests" parent="quality_control.menu_quality_control" action="application_test_action" sequence="60" groups="rsd_quality.group_quality_test_user,rsd_qa_management.group_qa_officer,base.group_system"/>

    <!-- In-Process Test -->
    <record id="inprocess_test_view_list" model="ir.ui.view">
        <field name="name">rsd.quality.inprocess.test.list</field>
        <field name="model">rsd.quality.inprocess.test</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'passed'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="process_stage"/>
                <field name="test_date"/>
                <field name="tested_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="inprocess_test_view_form" model="ir.ui.view">
        <field name="name">rsd.quality.inprocess.test.form</field>
        <field name="model">rsd.quality.inprocess.test</field>
        <field name="arch" type="xml">
            <form string="In-Process Test">
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit for Review" class="btn-primary" invisible="state not in ('draft','in_progress')"/>
                    <button name="action_pass" type="object" string="Pass" class="btn-primary" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <button name="action_fail" type="object" string="Fail" groups="rsd_qa_management.group_qa_officer" invisible="state != 'submitted'"/>
                    <button name="action_create_deviation" type="object" string="Create QA Deviation" groups="rsd_qa_management.group_qa_officer" invisible="state != 'failed' or deviation_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','in_progress')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,submitted,passed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="production_id" readonly="state != 'draft'"/>
                            <field name="product_id"/>
                            <field name="lot_id" domain="[('product_id', '=', product_id)]"/>
                            <field name="process_stage" placeholder="e.g. Mixing, Reaction, Cooling"/>
                        </group>
                        <group>
                            <field name="test_date"/>
                            <field name="tested_by"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_on"/>
                            <field name="deviation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="In-Process Parameters">
                            <field name="in_process_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter"/>
                                    <field name="specification"/>
                                    <field name="result_value"/>
                                    <field name="uom"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary"><field name="result_summary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="inprocess_test_action" model="ir.actions.act_window">
        <field name="name">In-Process Tests</field>
        <field name="res_model">rsd.quality.inprocess.test</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="inprocess_test_menu" name="In-Process Tests" parent="quality_control.menu_quality_control" action="inprocess_test_action" sequence="55" groups="rsd_quality.group_quality_test_user,rsd_qa_management.group_qa_officer,base.group_system"/>
</odoo>

<odoo noupdate="1">
    <record id="seq_rnd_project" model="ir.sequence">
        <field name="name">R&amp;D Project</field>
        <field name="code">rnd.project</field>
        <field name="prefix">RND/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_rnd_experiment" model="ir.sequence">
        <field name="name">R&amp;D Experiment No.</field>
        <field name="code">rnd.experiment</field>
        <field name="prefix">EXP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rnd_requirement" model="ir.sequence">
        <field name="name">R&amp;D Requirement</field>
        <field name="code">rnd.requirement</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

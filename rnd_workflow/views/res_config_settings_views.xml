<odoo>

    <record id="view_res_config_settings_rnd" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rnd.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="R&amp;D Workflow" string="R&amp;D Workflow" data-key="rnd_workflow">
                    <h2>R&amp;D Workflow</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="rnd_notify_stage_change"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="rnd_notify_stage_change"/>
                                <div class="text-muted">
                                    Schedule an activity for the responsible user whenever a project
                                    or experiment moves to a new stage.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="rnd_default_owner_id" string="Default R&amp;D Project Owner"/>
                                <div class="text-muted">
                                    Pre-filled as the R&amp;D project owner on new requirements.
                                </div>
                                <field name="rnd_default_owner_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_rnd_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'rnd_workflow'}</field>
        <field name="groups_id" eval="[(4, ref('rnd_workflow.group_rnd_owner'))]"/>
    </record>

</odoo>

<odoo>

    <record id="view_rnd_experiment_form" model="ir.ui.view">
        <field name="name">rnd.experiment.form</field>
        <field name="model">rnd.experiment</field>
        <field name="arch" type="xml">
            <form string="Batch / Experiment">
                <header>
                    <button name="action_assign" type="object" string="Assign to R&amp;D User" groups="rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start_execution" type="object" string="Start Execution" groups="rnd_workflow.group_rnd_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_submit_qc" type="object" string="Submit for QC" groups="rnd_workflow.group_rnd_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'execution'"/>
                    <button name="action_qc_accept" type="object" string="QC: Accept Request" groups="rnd_workflow.group_qc_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'qc_submitted'"/>
                    <button name="action_start_qc_analysis" type="object" string="Start QC Analysis" groups="rnd_workflow.group_qc_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'qc_accepted'"/>
                    <button name="action_submit_qc_report" type="object" string="Submit QC Report" groups="rnd_workflow.group_qc_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'qc_analysis'"/>
                    <button name="action_assign_performance" type="object" string="Assign Performance Check" groups="rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'qc_report'"/>
                    <button name="action_start_performance_check" type="object" string="Start Performance Check" groups="rnd_workflow.group_performance_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'performance_assigned'"/>
                    <button name="action_submit_performance_report" type="object" string="Submit Performance Report" groups="rnd_workflow.group_performance_officer,rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'performance_check'"/>
                    <button name="action_done" type="object" string="Finalize Experiment" groups="rnd_workflow.group_rnd_owner"
                            class="oe_highlight" invisible="state != 'performance_report'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" groups="rnd_workflow.group_rnd_owner"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,assigned,execution,qc_submitted,qc_accepted,qc_analysis,qc_report,performance_assigned,performance_check,performance_report,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="assigned_user_id" readonly="state != 'draft'"/>
                            <field name="rnd_owner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="qc_user_id" readonly="state not in ('draft', 'assigned', 'execution')"/>
                            <field name="performance_user_id" readonly="state not in ('draft', 'assigned', 'execution', 'qc_submitted', 'qc_accepted', 'qc_analysis', 'qc_report')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Execution">
                            <field name="execution_notes" placeholder="Execution notes..." readonly="state not in ('assigned', 'execution')"/>
                        </page>
                        <page string="QC">
                            <group>
                                <field name="qc_date" readonly="1"/>
                                <field name="qc_report" placeholder="QC analysis findings..." readonly="state != 'qc_analysis'"/>
                            </group>
                        </page>
                        <page string="Performance">
                            <group>
                                <field name="performance_date" readonly="1"/>
                                <field name="performance_report" placeholder="Performance check findings..." readonly="state != 'performance_check'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rnd_experiment_list" model="ir.ui.view">
        <field name="name">rnd.experiment.list</field>
        <field name="model">rnd.experiment</field>
        <field name="arch" type="xml">
            <list string="Batches / Experiments">
                <field name="name"/>
                <field name="project_id" readonly="state != 'draft'"/>
                <field name="assigned_user_id" readonly="state != 'draft'"/>
                <field name="qc_user_id" readonly="state not in ('draft', 'assigned', 'execution')"/>
                <field name="performance_user_id" readonly="state not in ('draft', 'assigned', 'execution', 'qc_submitted', 'qc_accepted', 'qc_analysis', 'qc_report')"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rnd_experiment_kanban" model="ir.ui.view">
        <field name="name">rnd.experiment.kanban</field>
        <field name="model">rnd.experiment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id" readonly="state != 'draft'"/>
                <field name="assigned_user_id" readonly="state != 'draft'"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="project_id" readonly="state != 'draft'"/></div>
                            <div t-if="record.assigned_user_id.value">
                                <field name="assigned_user_id" readonly="state != 'draft'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rnd_experiment_search" model="ir.ui.view">
        <field name="name">rnd.experiment.search</field>
        <field name="model">rnd.experiment</field>
        <field name="arch" type="xml">
            <search string="Batches / Experiments">
                <field name="name"/>
                <field name="project_id" readonly="state != 'draft'"/>
                <field name="assigned_user_id" readonly="state != 'draft'"/>
                <field name="qc_user_id" readonly="state not in ('draft', 'assigned', 'execution')"/>
                <field name="performance_user_id" readonly="state not in ('draft', 'assigned', 'execution', 'qc_submitted', 'qc_accepted', 'qc_analysis', 'qc_report')"/>
                <filter string="My Tasks" name="my_tasks"
                        domain="['|','|',('assigned_user_id','=',uid),('qc_user_id','=',uid),('performance_user_id','=',uid)]"/>
                <filter string="Open" name="open" domain="[('state','!=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Project" name="group_project" context="{'group_by':'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rnd_experiment" model="ir.actions.act_window">
        <field name="name">Batches / Experiments</field>
        <field name="res_model">rnd.experiment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a batch/experiment under an R&amp;D project</p>
        </field>
    </record>

</odoo>

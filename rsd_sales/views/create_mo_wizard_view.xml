<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_create_mo_wizard_form" model="ir.ui.view">
        <field name="name">sale.create.mo.wizard.form</field>
        <field name="model">sale.create.mo.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Manufacturing Order">
                <group>
                    <field name="is_packing_order"/>
                </group>

                <footer>
                    <button name="action_confirm_create_mo"
                            type="object"
                            string="Create MO"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

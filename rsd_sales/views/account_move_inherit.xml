<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hide_default_print_button" model="ir.ui.view">
        <field name="name">hide.default.print.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            
            <xpath expr="//header/button[@name='action_print_pdf']" position="replace">
                
            </xpath>

            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="tally_response" readonly="1"/>
                <field name="delivery_terms" readonly="state in ['posted']" invisible="move_type != 'out_invoice'"/>
                <field name="dispatch_doc_no" readonly="state in ['posted']" invisible="move_type != 'out_invoice'"/>
                <field name="dispatch_through" readonly="state in ['posted']" invisible="move_type != 'out_invoice'"/>
                <field name="bill_of_lading" readonly="state in ['posted']" invisible="move_type != 'out_invoice'"/>
                <field name="delivery_note" readonly="state in ['posted']" invisible="move_type != 'out_invoice'"/>
                <field name="motor_vehicle_no" readonly="state in ['posted']" invisible="move_type != 'out_invoice'"/>
            </xpath>

            

        </field>
    </record>

    <record id="account_move_form_custom_print" model="ir.ui.view">
        <field name="name">add.custom.print.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            
            <xpath expr="//header" position="inside">
                <button name="action_print_custom_invoice"
                        string="Print PDF"
                        type="object"
                        class="btn btn-primary"
                        invisible="move_type != 'out_invoice'"/>
            </xpath>

        </field>
    </record>

</odoo>

<odoo>
    <!-- Hide Internal Reference from Product Form View for Store Users -->
    <record id="product_template_form_hide_ref_by_dept" model="ir.ui.view">
        <field name="name">product.template.form.hide.ref.by.dept</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button string="RSD TEST BUTTON"
                    type="object"
                    class="btn-primary" />
            </xpath>

            <!-- Apply the 'invisible' attribute using the special 'user.' prefix -->
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="hide_default_code" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">product_variant_count &gt; 1 or hide_default_code</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide Internal Reference from Product List/Tree View for Store Users -->
    <record id="product_template_tree_hide_ref_by_dept" model="ir.ui.view">
        <field name="name">product.template.tree.hide.ref.by.dept</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">

            <!-- Apply the 'invisible' attribute to the field in the list view -->
            <field name="default_code" invisible="not hide_default_code">
            </field>

        </field>
    </record>
</odoo>
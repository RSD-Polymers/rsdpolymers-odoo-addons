<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_category_form_inherit_packaging" model="ir.ui.view">
        <field name="name">product.category.form.inherit.packaging</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">

            
            <xpath expr="//group[@name='logistics']" position="inside">
                <field name="is_packaging_category"/>
            </xpath>

        </field>
    </record>

</odoo>

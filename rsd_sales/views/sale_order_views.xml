<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    
    

    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">9999</field>

        <field name="arch" type="xml">

            
            
            

            <xpath expr="//sheet" position="before">

                <div class="alert alert-success mb-1"
                     role="alert"
                     invisible="not is_fully_in_stock or is_production_user_by_dept">

                    <strong>All products are currently in stock!</strong>
                    You can proceed to complete the Sales Order.

                </div>

                <div class="alert alert-danger mb-1"
                     role="alert"
                     invisible="not has_stock_shortage or is_production_user_by_dept">

                    <strong>Stock Shortage Warning:</strong>
                    Insufficient Packed FG stock for one or more products
                    on this order.

                </div>

                
                <div class="alert alert-info d-flex align-items-center justify-content-between"
                     role="status"
                     invisible="approval_state == 'approved' or is_production_user_by_dept">

                    <span>
                        <strong>Current Approval State:</strong>
                    </span>

                    <field name="approval_state"
                           widget="statusbar"
                           statusbar_visible="draft,send_for_checking,checked,send_for_approval"
                           class="ms-3"/>

                </div>

            </xpath>


            
            
            

            <xpath expr="//label[@for='commitment_date']"
                   position="attributes">

                <attribute name="string">
                    Expected Date of Receipt
                </attribute>

            </xpath>


            
            <xpath expr="//button[@id='create_invoice']"
                   position="attributes">

                <attribute name="groups">
                    account.group_account_user,
                    account.group_account_manager,
                    base.group_system
                </attribute>

            </xpath>


            
            <xpath expr="//button[@id='create_invoice_percentage']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            
            <xpath expr="//button[@id='send_proforma_primary']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>

            <xpath expr="//button[@id='send_proforma']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            
            <xpath expr="//button[@id='send_by_email']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>

            <xpath expr="//button[@id='send_by_email_primary']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            
            
            

            <xpath expr="//field[@name='partner_id']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='l10n_in_gst_treatment']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='partner_invoice_id']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='sale_order_template_id']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='validity_date']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='date_order']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>

            <xpath expr="//field[@name='payment_term_id']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>


            
            
            

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="attributes">

                <attribute name="readonly">
                    parent.approval_state == 'approved'
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']"
                   position="attributes">

                <attribute name="readonly">
                    parent.approval_state == 'approved'
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_id']"
                   position="attributes">

                <attribute name="readonly">
                    parent.approval_state == 'approved'
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']"
                   position="attributes">

                <attribute name="readonly">
                    parent.approval_state == 'approved'
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']"
                   position="attributes">

                <attribute name="readonly">
                    parent.approval_state == 'approved'
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']"
                   position="attributes">

                <attribute name="readonly">
                    parent.approval_state == 'approved'
                </attribute>

            </xpath>


            <xpath expr="//field[@name='sale_order_option_ids']"
                   position="attributes">

                <attribute name="readonly">
                    approval_state == 'approved' or state not in ('draft','sent')
                </attribute>

            </xpath>


            
            
            

            <xpath expr="//field[@name='state']"
                   position="attributes">

                <attribute name="statusbar_visible">
                    draft,sent,sale
                </attribute>

            </xpath>


            
            
            

            <xpath expr="//field[@name='user_id']"
                   position="after">

                <field name="approval_manager_id"
                       readonly="approval_state == 'approved'"/>

            </xpath>


            
            
            

            <xpath expr="//field[@name='payment_term_id']"
                   position="after">

                <field name="special_instructions"
                       readonly="approval_state not in ('draft','send_for_checking','checked')"/>

                <field name="is_production_user_by_dept"
                       invisible="1"/>

            </xpath>


            <xpath expr="//field[@name='sale_order_template_id']"
                   position="after">

                <field name="dispatch_through"
                       readonly="state in ['sale', 'done'] or approval_state != 'draft'"/>

            </xpath>


            
            
            

            <xpath expr="//field[@name='order_line']//field[@name='product_id']"
                   position="attributes">

                <attribute name="domain">
                    [
                        ('sale_ok', '=', True),
                        '|',
                        ('company_id', '=', False),
                        ('company_id', '=', parent.company_id),
                        ('categ_id.name', 'in', ['Services', 'Finished Goods (Pack)'])
                    ]
                </attribute>

            </xpath>


            
            
            

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="after">

                <field name="qty_available"
                       readonly="1"
                       string="Qty Available"
                       title="Quantity Available"/>

                <field name="qty_packed_inventory"
                       readonly="1"
                       string="FG Packed Qty"
                       title="Packed Inventory"/>

            </xpath>


            
            
            

            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']"
                   position="attributes">

                <attribute name="string">
                    Packaging Qty
                </attribute>

                <attribute name="style">
                    min-width:140px;
                </attribute>

            </xpath>


            
            
            
            

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="before">

                <field name="available_lot_ids"
                       column_invisible="True"/>

                <field name="lot_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       domain="[('id', 'in', available_lot_ids)]"
                       width="200"
                       readonly="parent.state in ('sale','done','cancel')"/>

            </xpath>


            
            
            

            <xpath expr="//field[@name='tax_totals']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='partner_id']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='l10n_in_gst_treatment']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='partner_invoice_id']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='pricelist_id']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='payment_term_id']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='sale_order_template_id']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>


            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']"
                   position="attributes">

                <attribute name="column_invisible">
                    parent.is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']"
                   position="attributes">

                <attribute name="column_invisible">
                    parent.is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']"
                   position="attributes">

                <attribute name="column_invisible">
                    parent.is_production_user_by_dept
                </attribute>

            </xpath>


            <xpath expr="//page[@name='other_information']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>

            <xpath expr="//page[@name='customer_signature']"
                   position="attributes">

                <attribute name="invisible">
                    is_production_user_by_dept
                </attribute>

            </xpath>


            
            <xpath expr="//button[@name='action_preview_sale_order']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            
            
            
            

            <xpath expr="//button[@id='action_confirm']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>

            <xpath expr="//button[@name='action_confirm' and not(@id='action_confirm')]"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            
            
            

            <xpath expr="//header"
                   position="inside">

                
                
                

                <button name="action_send_for_checking"
                        type="object"
                        string="Send for Checking"
                        class="btn-primary"
                        invisible="state not in ('draft','sent') or approval_state != 'draft'"/>


                
                
                

                <button name="action_checker_checked"
                        type="object"
                        string="Checked"
                        class="oe_highlight"
                        invisible="approval_state != 'send_for_checking'"/>


                
                
                

                <button name="action_checker_reject"
                        type="object"
                        string="Reject"
                        invisible="approval_state != 'send_for_checking'"/>


                
                
                

                <button name="action_send_for_approval"
                        type="object"
                        string="Send for Approval"
                        class="btn-primary"
                        invisible="approval_state != 'checked' or state not in ('draft','sent')"/>


                
                
                

                <button name="action_approve_order"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        groups="rsd_sales.group_sale_approver"
                        invisible="approval_state != 'send_for_approval'"/>


                
                
                

                <button name="action_reject_order"
                        type="object"
                        string="Reject"
                        groups="rsd_sales.group_sale_approver"
                        invisible="approval_state != 'send_for_approval'"/>

            </xpath>


            
            
            

            <xpath expr="//page[@name='other_information']"
                   position="after">

                <page string="Approval History"
                      name="approval_history"
                      invisible="is_production_user_by_dept">

                    <group>

                        <group>

                            <field name="approval_state"
                                   readonly="1"/>

                            <field name="checker_id"
                                   string="Sales Executive-BD (Checker)"
                                   readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>

                        </group>

                        <group>

                            <field name="approval_manager_id"
                                   string="Sales Manager"
                                   readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>

                            <field name="rejection_remarks"
                                   readonly="1"
                                   widget="text"/>

                        </group>

                    </group>

                </page>

            </xpath>


            
            
            

            <xpath expr="//header"
                   position="inside">

                <button name="action_reserve_fg"
                        type="object"
                        string="Reserve FG"
                        class="btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="state != 'sale' or not store_user"/>

                <button name="action_unreserve_fg"
                        type="object"
                        string="Unreserve FG"
                        class="btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="state != 'sale' or not store_user"/>

                <button name="action_deliver_available"
                        type="object"
                        string="Deliver Available"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="state != 'sale' or not store_user"/>

                <button name="action_wait_for_complete"
                        type="object"
                        string="Wait for Complete"
                        class="btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="state != 'sale' or not store_user"/>

            </xpath>


            
            
            

            <xpath expr="//page[@name='other_information']"
                   position="before">

                <page string="FG Fulfilment"
                      name="fg_fulfilment">

                    <group>

                        <group>

                            <field name="fg_delivery_mode"
                                   readonly="state != 'sale'"/>

                            <field name="has_stock_shortage"
                                   readonly="1"/>

                        </group>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_tree_pending_requests" model="ir.ui.view">
        <field name="name">sale.order.tree.pending.requests</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_order"/>
                <field name="user_id"/>
                <field name="mat_ready_date"/>
                <field name="production_request_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_awaiting_readiness_orders" model="ir.actions.act_window">
        <field name="name">Pending Requests</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale_order_tree_pending_requests"/>
        <field name="domain">[('state', '=', 'awaiting_readiness')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending production requests found.
            </p>
        </field>
    </record>

    <record id="menu_pending_production_requests" model="ir.ui.menu">
        <field name="name">Pending Request</field>
        <field name="action" ref="action_awaiting_readiness_orders"/>
        <field name="parent_id" ref="mrp.menu_mrp_manufacturing"/>
        <field name="groups_id" eval="[(6, 0, [ref('mrp.group_mrp_user'), ref('mrp.group_mrp_manager')])]"/>
        <field name="sequence">0</field>
    </record>

    <record id="view_quotation_tree_inherit_readiness_color" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.readiness.color</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-warning">state == 'awaiting_readiness' or state == 'trial'</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="mat_ready_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-success mb-1" role="alert"
                     invisible="not is_fully_in_stock or is_production_user_by_dept">
                    <strong>All products are currently in stock!</strong>
                    You can proceed to complete the Sales Order.
                </div>

                <div class="alert alert-danger mb-1" role="alert"
                     invisible="not has_stock_shortage or is_production_user_by_dept">
                    <strong>Stock Shortage Warning:</strong>
                    Insufficient Packed FG stock for one or more products on this order.
                </div>

                <div class="alert alert-info d-flex align-items-center justify-content-between"
                     role="status"
                     invisible="approval_state == 'approved' or is_production_user_by_dept">

                    <span>
                        <strong>Current Approval State:</strong>
                    </span>

                    <field name="approval_state"
                           widget="statusbar"
                           statusbar_visible="draft,send_for_checking,checked,send_for_approval"
                           class="ms-3"/>
                </div>
            </xpath>
            <xpath expr="//label[@for='commitment_date']" position="attributes">
                <attribute name="string">Expected Date of Receipt</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='send_by_email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='send_by_email_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_option_ids']" position="attributes">
                <attribute name="readonly">approval_state != 'draft' or state not in ('draft','sent')</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,awaiting_readiness,trial,sent,sale</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="approval_manager_id"
                       readonly="approval_state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="is_rd_user" invisible="1"/>
                <field name="mat_ready_date"
                       readonly="not (state == 'awaiting_readiness' and approval_state == 'approved')"/>
                <field name="production_request_type"
                       readonly="approval_state != 'draft'"/>
                <field name="dispatch_date"
                       readonly="state in ('sale','done') or approval_state not in ('draft','approved')"/>
                <field name="special_instructions"
                       readonly="approval_state not in ('draft','send_for_checking','checked')"/>
                <field name="is_production_user_by_dept" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <field name="dispatch_through"
                       readonly="state in ['sale', 'done'] or approval_state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="qty_available" readonly="1" string="Qty Available" title="Quantity Available"/>
                <field name="qty_packed_inventory" readonly="1" string="FG Packed Qty" title="Packed Inventory"/>
                <!--  Field is hidden as not required on 20th Feb 2026
                <field name="qty_unpacked_inventory" width="120" readonly="1" string="FG Unpacked Qty"-->
                <!--                       title="Unpacked Inventory"/>-->
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']"
                   position="attributes">
                <attribute name="string">Packaging Qty</attribute>
                <attribute name="style">min-width:140px;</attribute>
            </xpath>

            <!-- Hide all customer and pricing details from the production users and managers. -->
            <!-- The original xpath for amount_total, amount_untaxed, etc. was incorrect.
                 This xpath targets the correct parent group to hide the total and subtotals. -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="column_invisible">parent.is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="column_invisible">parent.is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">parent.is_production_user_by_dept</attribute>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">is_production_user_by_dept</attribute>
            </xpath>

            <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_confirm' and not(@id='action_confirm')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ADD YOUR CUSTOM BUTTONS IN HEADER -->
            <xpath expr="//header" position="inside">

                <field name="is_production_request_sent" invisible="1"/>

                <button name="%(action_sale_create_mo_wizard)d"
                        type="action"
                        string="Create MO"
                        class="oe_highlight"
                        groups="mrp.group_mrp_user,mrp.group_mrp_manager"
                        invisible="state != 'awaiting_readiness' or approval_state != 'approved' or mrp_order_count != 0"/>

                <button name="action_send_for_checking"
                        type="object"
                        string="Send for Checking"
                        class="btn-primary"
                        invisible="state not in ('draft','sent') or approval_state != 'draft'"/>

                <button name="action_checker_checked"
                        type="object"
                        string="Checked"
                        class="oe_highlight"
                        invisible="approval_state != 'send_for_checking'"/>

                <button name="action_checker_reject"
                        type="object"
                        string="Reject"
                        invisible="approval_state != 'send_for_checking'"/>

                <button name="action_send_for_approval"
                        type="object"
                        string="Send for Approval"
                        class="btn-primary"
                        invisible="approval_state != 'checked' or state not in ('draft','sent')"/>

                <button name="action_approve_order"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="approval_state != 'send_for_approval'"/>

                <button name="action_reject_order"
                        type="object"
                        string="Reject"
                        invisible="approval_state != 'send_for_approval'"/>

                <button name="action_confirm_from_readiness"
                        type="object"
                        string="Confirm Order"
                        class="btn-primary"
                        groups="__export__.res_groups_222_4190eb7c"
                        invisible="state != 'awaiting_readiness' or approval_state != 'approved' or mrp_order_count == 0"/>

            </xpath>

            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button class="oe_stat_button"
                        name="action_view_mrp_orders"
                        type="object"
                        icon="fa-industry"
                        invisible="mrp_order_count == 0">
                    <field name="mrp_order_count" widget="statinfo" string="Manufacturing Order"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="after">

                <page string="Approval History" name="approval_history" invisible="is_production_user_by_dept">
                    <group>
                        <group>
                            <field name="approval_state"
                                   readonly="1"/>
                            <field name="checker_id"
                                   string="Sales Executive-BD (Checker)"
                                   readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="approval_manager_id"
                                   string="Sales Manager"
                                   readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="rejection_remarks"
                                   readonly="1"
                                   widget="text"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
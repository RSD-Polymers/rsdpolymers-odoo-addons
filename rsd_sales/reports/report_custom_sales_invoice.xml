<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="action_custom_invoice_pdf" model="ir.actions.report">
        <field name="name">Custom Sales Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rsd_sales.report_custom_sales_invoice</field>
        <field name="report_file">rsd_sales.report_custom_sales_invoice</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
    </record>

    
    <template id="report_custom_sales_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="rsd_sales.standard_sales_invoice_layout"/>
            </t>
        </t>
    </template>

    <template id="standard_sales_invoice_layout">
        <t t-set="o" t-value="o"/>

        
        <t t-set="shipping_partner" t-value="o.partner_shipping_id or o.partner_id"/>
        <t t-set="billing_partner" t-value="o.partner_id"/>

        
        <t t-set="so" t-value="o.invoice_line_ids.sale_line_ids.order_id or None"/>
        <t t-if="so and len(so) &gt; 1">
            <t t-set="so" t-value="so[0]"/>
        </t>

        
        <t t-set="tax_lines" t-value="o.line_ids.filtered(lambda l: l.tax_line_id)"/>

        <t t-call="web.external_layout">
            <style>
                * {
                font-family: DejaVu Sans, sans-serif !important;
                }

                table, td, th {
                padding-top: 3px !important;
                padding-bottom: 3px !important;
                }

                p {
                margin: 0 !important;
                }
            </style>
            <div class="page" style="font-size:12px; font-family: DejaVu Sans, sans-serif;">
                <div class="oe_structure"/>

                
                <div class="row">
                    <div class="col-8 text-center">
                        <h4 class="mb-0">Tax Invoice
                            <small class="text-muted">(ORIGINAL FOR RECIPIENT)</small>
                        </h4>
                    </div>
                    <div class="col-4 text-right">
                        <div class="small font-weight-bold">e-Invoice</div>
                        <div class="d-inline-block border border-dark p-1"
                             style="width: 100px; height: 100px; background-color: #f0f0f0;">
                            QR Code Placeholder
                        </div>
                    </div>
                </div>

                
                <div class="row mb-2" style="font-size: 14px;">
                    <div class="col-12 p-1 text-left">
                        <div>IRN:
                            <span class="font-weight-bold">
                            </span>
                        </div>
                        <div>Ack No:
                            <span class="font-weight-bold">

                            </span>
                        </div>
                        <div>Ack Date:
                            <span class="font-weight-bold">

                            </span>
                        </div>
                    </div>
                </div>

                
                <table style="width:100%; border-collapse:collapse; border:1px solid black; page-break-inside: avoid !important; font-size: 14px;">
                    <tbody>

                        <tr>
                            <td colspan="3"
                                style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Invoice From (Seller)</span>
                            </td>

                            <td style="width:25%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Invoice No</span>
                            </td>

                            <td style="width:25%; padding: 5px; border-bottom:1px solid black;">
                                <strong t-field="o.name"/>
                            </td>
                        </tr>

                        <tr>
                            <td rowspan="5" colspan="3"
                                style="width:50%; padding: 5px; border-right:1px solid black; border-bottom:1px solid black; vertical-align: top;">
                                <p style="margin-bottom: 5px;">
                                    <span style="font-weight: bold;">
                                        <t t-esc="o.company_id.partner_id.name"/>
                                    </span>
                                    <br/>
                                    <span t-field="o.company_id.partner_id.street"/>
                                    <t t-if="o.company_id.partner_id.street2">
                                        <br/>
                                        <span t-field="o.company_id.partner_id.street2"/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.city">,
                                        <span t-field="o.company_id.partner_id.city"/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.zip">-
                                        <span t-field="o.company_id.partner_id.zip"/>
                                    </t>
                                    <br/>
                                    <span>E-mail:</span>
                                    <span t-field="o.company_id.email"/>
                                    <br/>
                                    <span>GSTIN/UIN:</span>
                                    <span t-field="o.company_id.vat"/>
                                    <br/>
                                    <span>State Name:</span>
                                    <span t-field="o.company_id.state_id.name"/>
                                    <br/>
                                    <span>State Code:</span>
                                    <span t-field="o.company_id.state_id.l10n_in_tin"/>
                                </p>
                            </td>

                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Invoice Date</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Delivery Note No.</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.delivery_note"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Mode/Terms of Payment</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.invoice_payment_term_id.name"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Reference No. &amp; Date</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.ref"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Buyer's Order No</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.invoice_origin"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="3"
                                rowspan="6"
                                style="width:50%; padding: 0; border-right:1px solid black; border-bottom:1px solid black; vertical-align: top;">
                                <table style="width:100%; border-collapse: collapse; table-layout: fixed; line-height: 1.2; font-size: 14px;">
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black;">
                                            Consignee (Ship to)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black; vertical-align: top; min-height: 80px;">
                                            <strong>
                                                <span t-field="shipping_partner.name"/>
                                            </strong>
                                            <br/>
                                            <span t-field="shipping_partner.street"/>
                                            <t t-if="shipping_partner.street2">
                                                <br/>
                                                <span t-field="shipping_partner.street2"/>
                                            </t>
                                            <t t-if="shipping_partner.city">,
                                                <span t-field="shipping_partner.city"/>
                                            </t>
                                            <t t-if="shipping_partner.zip">-
                                                <span t-field="shipping_partner.zip"/>
                                            </t>
                                            <br/>
                                            <span>GSTIN/UIN:</span>
                                            <span t-field="shipping_partner.vat"/>
                                            <br/>
                                            <span>State Name:</span>
                                            <span t-field="shipping_partner.state_id.name"/>
                                            <br/>
                                            <span>State Code:</span>
                                            <span t-field="shipping_partner.state_id.l10n_in_tin"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; border-bottom:1px solid black;">
                                            Buyer (Bill to)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:100%; padding: 5px; vertical-align: top;">
                                            <strong>
                                                <span t-field="billing_partner.name"/>
                                            </strong>
                                            <br/>
                                            <span t-field="billing_partner.street"/>
                                            <t t-if="billing_partner.street2">
                                                <br/>
                                                <span t-field="billing_partner.street2"/>
                                            </t>
                                            <t t-if="billing_partner.city">,
                                                <span t-field="billing_partner.city"/>
                                            </t>
                                            <t t-if="billing_partner.zip">-
                                                <span t-field="billing_partner.zip"/>
                                            </t>
                                            <br/>
                                            <span>GSTIN/UIN:</span>
                                            <span t-field="billing_partner.vat"/>
                                            <br/>
                                            <span>State Name:</span>
                                            <span t-field="billing_partner.state_id.name"/>
                                            <br/>
                                            <span>State Code:</span>
                                            <span t-field="billing_partner.state_id.l10n_in_tin"/>
                                        </td>
                                    </tr>
                                </table>

                            </td>

                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Dispatch Doc No</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.dispatch_doc_no"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Delivery Note Date</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.delivery_date" t-options='{"widget": "date"}'/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Dispatched through</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.dispatch_through"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Bill of Lading/LR-RR No</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.bill_of_lading"/>
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 5px; border-right:1px solid black; border-bottom:1px solid black;">
                                <span>Motor Vehicle No</span>
                            </td>
                            <td style="padding: 5px; border-bottom:1px solid black;">
                                <strong>
                                    <span t-field="o.motor_vehicle_no"/>
                                </strong>
                            </td>
                        </tr>


                        <tr>
                            <td colspan="2"
                                style="padding: 5px; border-right: 1px solid black; border-bottom: 1px solid black;">
                                <span>Terms of Delivery</span>
                                <br/>
                                <strong>
                                    <span t-field="o.delivery_terms"/>
                                </strong>
                            </td>
                        </tr>

                    </tbody>
                </table>                

                
                <table class="w-100"
                       style="font-size: 14px; border-collapse: collapse; border-top: none; border-left: 1px solid black; border-right: 1px solid black; border-bottom: 1px solid black;">
                    <thead>
                        <tr class="text-center" style="border-bottom: 1px solid black;">
                            <th class="w-5" style="border-right: 1px solid black; padding: 5px;">Sl No.</th>
                            <th class="w-40" style="border-right: 1px solid black; padding: 5px;">Description of Goods
                            </th>
                            <th class="w-10" style="border-right: 1px solid black; padding: 5px;">HSN/SAC</th>
                            <th class="w-10" style="border-right: 1px solid black; padding: 5px;">Quantity</th>
                            <th class="w-10" style="border-right: 1px solid black; padding: 5px;">Rate</th>
                            <th class="w-5" style="border-right: 1px solid black; padding: 5px;">UOM</th>
                            <th class="w-10" style="padding: 5px;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="current_sl_no" t-value="1"/>
                        <t t-set="total_untaxed_amount" t-value="0.0"/>

                        
                        <t t-foreach="o.invoice_line_ids.filtered(lambda l: not l.tax_line_id)" t-as="line">

                            <t t-if="line.display_type == 'product' or not line.display_type">

                                <t t-set="total_untaxed_amount" t-value="total_untaxed_amount + line.price_subtotal"/>

                                
                                <tr>
                                    <td class="text-center align-top"
                                        style="border-right: 1px solid black; padding: 5px;">
                                        <span t-esc="current_sl_no"/>
                                    </td>
                                    <td class="align-top" style="border-right: 1px solid black; padding: 5px;">
                                        <span t-field="line.name"/>

                                        <t t-if="line.sale_line_ids">
                                            <t t-set="lots"
                                               t-value="line.sale_line_ids.mapped('lot_ids').mapped('name')"/>
                                            <t t-if="lots">
                                                <br/>
                                                <span style="font-size:12px;">
                                                    Lots:
                                                    <span t-esc="', '.join(lots)"/>
                                                </span>
                                            </t>
                                        </t>
                                        
                                        <t t-if="line.product_id and line.product_id.packaging_ids">
                                            <div style="margin-top: 2px;">
                                                <small>PACKING-
                                                    <span t-field="line.product_id.packaging_ids[0].name"/>
                                                </small>
                                            </div>
                                        </t>
                                    </td>
                                    <td class="text-center align-top"
                                        style="border-right: 1px solid black; padding: 5px;">
                                        
                                        <t t-if="line.product_id">
                                            <span t-field="line.product_id.l10n_in_hsn_code"/>
                                        </t>
                                    </td>
                                    <td class="text-right align-top"
                                        style="border-right: 1px solid black; padding: 5px; text-align: right !important;">
                                        <span t-field="line.quantity" t-options='{"widget": "float", "precision": 3}'/>
                                    </td>
                                    <td class="text-right align-top"
                                        style="border-right: 1px solid black; padding: 5px; text-align: right !important;">
                                        <span t-field="line.price_unit"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-center align-top"
                                        style="border-right: 1px solid black; padding: 5px;">
                                        <span t-field="line.product_uom_id.name"/>
                                    </td>
                                    <td class="text-right align-top"
                                        style="padding: 5px; text-align: right !important;">
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>

                                <t t-set="current_sl_no" t-value="current_sl_no + 1"/>

                            </t>

                            
                            
                            
                            
                            
                            
                            
                            
                            

                            <t t-if="line.display_type == 'line_section'">
                                
                                <tr>
                                    <td colspan="7" class="text-center font-weight-bold"
                                        style="padding: 5px; border-top: 1px solid black;">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>

                        </t>

                        
                        <t t-if="tax_lines">
                            
                            <t t-foreach="tax_lines" t-as="tax_line">
                                <tr>
                                    
                                    <td class="text-center align-middle"
                                        style="border-right: 1px solid black; padding: 5px;"></td>
                                    
                                    <td colspan="4" class="align-middle"
                                        style="border-right: 1px solid black; padding: 5px;">
                                        <span class="font-weight-bold" style="float: right;" t-field="tax_line.name"/>
                                    </td>
                                    
                                    <td class="text-right align-middle"
                                        style="border-right: 1px solid black; padding: 5px;"></td>
                                    
                                    <td class="text-right align-middle"
                                        style="padding: 5px; text-align: right !important;">
                                        
                                        <span t-esc="o.currency_id.round(abs(tax_line.amount_currency))"
                                              t-options="{&quot;widget&quot;:&quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </t>


                        
                        
                        <t t-set="total_subtotals_and_taxes"
                           t-value="sum(line.price_subtotal for line in o.invoice_line_ids.filtered(lambda l: not l.tax_line_id)) + sum(tax_line.amount_currency for tax_line in tax_lines)"/>
                        <t t-set="round_off_display" t-value="o.amount_total - total_subtotals_and_taxes"/>

                        
                        <t t-set="amount_total_display" t-value="o.amount_total"/>

                        <t t-if="abs(round_off_display) &gt; 0.001">
                        </t>

                        
                        <t t-set="total_qty"
                           t-value="sum(line.quantity for line in o.invoice_line_ids.filtered(lambda l: not l.display_type or l.display_type == 'product'))"/>
                        <tr class="font-weight-bold">
                            
                            <td class="text-center"
                                style="border-right: 1px solid black; padding: 5px; border-top: 1px solid black;"></td>
                            
                            <td class="text-right"
                                style="border-right: 1px solid black; padding: 5px; border-top: 1px solid black;">
                                <strong>Total</strong>
                            </td>
                            
                            <td class="text-right"
                                style="border-right: 1px solid black; padding: 5px; border-top: 1px solid black;"></td>
                            
                            <td class="text-right"
                                style="border-right: 1px solid black; padding: 5px; border-top: 1px solid black; text-align: right !important;">
                                
                                
                                
                            </td>
                            
                            <td class="text-right"
                                style="border-right: 1px solid black; padding: 5px; border-top: 1px solid black;"></td>
                            
                            <td class="text-right"
                                style="border-right: 1px solid black; padding: 5px; border-top: 1px solid black;"></td>
                            
                            <td class="text-right"
                                style="padding: 5px; border-top: 1px solid black; text-align: right !important;">
                                <span t-esc="amount_total_display"
                                      t-options='{"widget":"float", "precision": 0, "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                
                <t t-set="total_tax_amount" t-value="o.amount_tax"/>

                
                
                

                
                
                <div style="width: 100%; clear: both; padding: 0;">
                    <table class="table table-sm w-100"
                           style="table-layout: fixed; border-collapse: collapse; border: 1px solid black; margin-bottom: 0;">
                        <tr>
                            
                            <td class="p-2" style="width: 100%; vertical-align: top;">

                                
                                <div style="width: 50%; float: left;">
                                    <div class="font-weight-bold">Amount Chargeable (in words)</div>
                                    
                                    <div style="font-size: 12px; font-weight: normal;">
                                        <strong>Indian Rupees</strong>
                                        <t t-if="o.currency_id">
                                            <strong>
                                                <span t-esc="o.currency_id.amount_to_text(round(o.amount_total or 0.0))"/>
                                            </strong>
                                        </t>
                                        <t t-else="">
                                            <strong>
                                                <span t-esc="round(o.amount_total or 0.0)"/>
                                            </strong>
                                        </t>
                                        <strong>Only</strong>
                                    </div>
                                </div>

                                
                                <div style="width: 50%; float: right; text-align: right;">
                                    <div class="small font-weight-bold">E. &amp; O.E.</div>
                                </div>

                                
                                <div style="clear: both;"/>
                            </td>
                        </tr>
                    </table>
                </div>

                

                <t t-set="company_bank"
                   t-value="o.company_id.partner_id.bank_ids.filtered(
                       lambda b: (not b.company_id or b.company_id == o.company_id)
                   )[:1]"/>

                <table class="table table-sm w-100"
                       style="table-layout: fixed;border-collapse: collapse;border-left: 1px solid black;border-right: 1px solid black;border-bottom: 1px solid black;margin-top: 0;">

                    
                    <thead>
                        <tr style="background-color:#f0f0f0;">
                            <th class="p-1 text-center" style="width:10%; border-right:1px solid black;">HSN/SAC</th>
                            <th class="p-1 text-center" style="width:15%; border-right:1px solid black;">Taxable Value
                            </th>
                            <th class="p-1 text-center" style="width:8%; border-right:1px solid black;">CGST %</th>
                            <th class="p-1 text-center" style="width:12%; border-right:1px solid black;">CGST Amt</th>
                            <th class="p-1 text-center" style="width:8%; border-right:1px solid black;">SGST %</th>
                            <th class="p-1 text-center" style="width:12%; border-right:1px solid black;">SGST Amt</th>
                            <th class="p-1 text-center" style="width:8%; border-right:1px solid black;">IGST %</th>
                            <th class="p-1 text-center" style="width:12%; border-right:1px solid black;">IGST Amt</th>
                            <th class="p-1 text-center" style="width:15%;">Total Tax Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="hsn_summary" t-value="o._get_hsn_summary_data()"/>

                        <t t-foreach="hsn_summary" t-as="data">
                            <tr>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <span t-esc="data['hsn_code']"/>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <span t-esc="data['taxable_value']"
                                          t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <t t-if="data['cgst_rate']"><span t-esc="data['cgst_rate']"/>%
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <t t-if="data['cgst_amount']">
                                        <span t-esc="data['cgst_amount']"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <t t-if="data['sgst_rate']"><span t-esc="data['sgst_rate']"/>%
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <t t-if="data['sgst_amount']">
                                        <span t-esc="data['sgst_amount']"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <t t-if="data['igst_rate']"><span t-esc="data['igst_rate']"/>%
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                    <t t-if="data['igst_amount']">
                                        <span t-esc="data['igst_amount']"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td class="p-1" style="text-align:right !important;">
                                    <span t-esc="data['total_tax_amount_hsn']"
                                          t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                </td>
                            </tr>
                        </t>

                        
                        <tr class="font-weight-bold" style="border-top:1px solid black;">
                            <td class="text-center" style="border-right:1px solid black;">Total</td>
                            <td class="p-1" style="border-right:1px solid black; text-align:right !important;">
                                <span t-esc="o.amount_untaxed"
                                      t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                            </td>
                            <td colspan="6" class="text-center" style="border-right:1px solid black;">
                                Total Tax Amount
                            </td>
                            <td class="p-1" style="text-align:right !important;">
                                <span t-esc="o.amount_tax"
                                      t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                            </td>
                        </tr>

                        
                        <tr>
                            <td colspan="9" style="border-top:1px solid black; padding:4px;">
                                <b>Tax Amount (in words):</b>
                                <span t-esc="o.currency_id.amount_to_text(o.amount_tax)"/>
                            </td>
                        </tr>
                    </tbody>
                    <tbody style="page-break-inside: avoid; break-inside: avoid;">

                        
                        <tr>
                            <td colspan="5" style="border-right:1px solid black; padding:4px;">
                                <b>Company’s Bank Details</b>
                                <br/>
                                A/c Holder :
                                <span t-esc="o.company_id.name"/>
                                <br/>
                                Bank Name :
                                <span t-esc="company_bank and company_bank[0].bank_id.name or ''"/>
                                <br/>
                                A/c No :
                                <span t-esc="company_bank and company_bank[0].acc_number or ''"/>
                                <br/>
                                IFSC Code :
                                <span t-esc="company_bank and company_bank[0].bank_id.bic or ''"/>
                            </td>

                            <td colspan="4" style="text-align:center; padding:4px; vertical-align:top;">
                                <div style="margin-bottom:40px;">
                                    for
                                    <strong>
                                        <span t-field="o.company_id.name"/>
                                    </strong>
                                </div>
                                <div style="border-top:1px solid black; width:250px; margin:0 auto; padding-top:4px;">
                                    Authorised Signatory
                                </div>
                            </td>
                        </tr>

                        
                        <tr>
                            <td colspan="9" style="border-top:1px solid black; padding:4px;">
                                <b>Declaration:</b>
                                We declare that this invoice shows the actual price of the goods described
                                and that all particulars are true and correct.
                            </td>
                        </tr>

                        
                        <tr>
                            <td colspan="9" style="text-align:center; font-size:11px;">
                                *This is a Computer Generated Invoice
                            </td>
                        </tr>

                    </tbody>
                </table>
                
                <div class="oe_structure"/>
            </div>
        </t> 
    </template> 

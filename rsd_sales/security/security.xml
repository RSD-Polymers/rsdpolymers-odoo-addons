<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        This group replaces the old "__export__.res_groups_222_4190eb7c" reference
        that was hard-coded throughout the module. That ID was generated by an
        Odoo Studio export on the original developer's database and does not
        exist on a fresh install, which would break every view/record that
        referenced it. This group defines the same "Sales Order Approver" role
        properly, as a normal module-owned security group. It implies the
        standard Sales / Manager group, so anyone in it also gets the usual
        sales manager rights.
    -->
    <record id="group_sale_approver" model="res.groups">
        <field name="name">Sales Order Approver</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Users who can approve/reject Sales Orders and confirm orders coming out of the readiness workflow.</field>
    </record>

    <!--
        This group replaces the old "base.group_research_and_development"
        reference, which is not a group that exists anywhere in Odoo core.
        Assign this group to R&D team members so that new orders they create
        default to the "Trial for Process Development" production request type.
    -->
    <record id="group_rd_user" model="res.groups">
        <field name="name">R&amp;D User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="comment">Users in the Research and Development team. Sales orders they create default to the "Trial" production request type.</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree (List) View for Tally Ledger Group -->
        <record id="view_tally_ledger_group_tree" model="ir.ui.view">
            <field name="name">tally.ledger.group.tree</field>
            <field name="model">tally.ledger.group</field>
            <field name="arch" type="xml">
                <list string="Tally Ledger Groups">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="is_primary_group"/>
                    <field name="tally_guid" optional="hide"/>
                    <field name="last_sync_date" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Form View for Tally Ledger Group -->
        <record id="view_tally_ledger_group_form" model="ir.ui.view">
            <field name="name">tally.ledger.group.form</field>
            <field name="model">tally.ledger.group</field>
            <field name="arch" type="xml">
                <form string="Tally Ledger Group">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id"/>
                            </group>
                            <group>
                                <field name="is_primary_group"/>
                                <field name="tally_guid"/>
                                <field name="last_sync_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Child Groups">
                                <field name="child_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="is_primary_group"/>
                                        <field name="tally_guid"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Tally Ledger Group -->
        <record id="view_tally_ledger_group_search" model="ir.ui.view">
            <field name="name">tally.ledger.group.search</field>
            <field name="model">tally.ledger.group</field>
            <field name="arch" type="xml">
                <search string="Search Tally Ledger Group">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="tally_guid"/>
                    <filter string="Primary Groups" name="primary_groups" domain="[('is_primary_group', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Parent Group" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
                        <filter string="Is Primary Group" name="group_by_is_primary"
                                context="{'group_by': 'is_primary_group'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for Tally Ledger Group -->
        <record id="action_tally_ledger_group" model="ir.actions.act_window">
            <field name="name">Tally Ledger Groups</field>
            <field name="res_model">tally.ledger.group</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Tally Ledger Group
                </p>
                <p>
                    This section allows you to manage the ledger groups imported or synchronized from Tally.
                    These groups are used to categorize your Chart of Accounts for Tally integration.
                </p>
            </field>
        </record>

        <!-- Menu Item for Tally Ledger Group under Accounting -> Configuration -->
        <menuitem id="menu_accounting_tally_configuration"
                  name="Tally"
                  parent="account.menu_finance_configuration" sequence="10"/>
        <menuitem id="menu_tally_ledger_group"
                  name="Tally Ledger Groups"
                  parent="menu_accounting_tally_configuration" action="action_tally_ledger_group"
                  sequence="10"/>

    </data>
</odoo>